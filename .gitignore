# ── Build output ─────────────────────────────────────────────
dist/
.astro/
.output/
*.tsbuildinfo

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Caches ───────────────────────────────────────────────────
.cache/
.vite/
.eslintcache
.parcel-cache/
.turbo/

# ── Test / coverage ──────────────────────────────────────────
coverage/
.nyc_output/

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Environment variables (never commit real values) ─────────
# `env.example` is the committed, sanitised template — keep it.
.env
.env.*
!.env.example

# ── OS noise ─────────────────────────────────────────────────
# macOS
.DS_Store
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editors / IDEs ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.orig

# ── Agent handoffs — local working notes, not version-controlled ─
# The reusable template lives in docs/templates/handoff.md (committed);
# individual handoffs under apps/site/docs/handoffs/ are per-session and stay local.
apps/site/docs/handoffs/

# ── Claude Code — personal, machine-specific settings ────────
# Shared team settings belong in .claude/settings.json (committed).
# The *.local.json variant is per-machine and must stay out of VCS.
.claude/settings.local.json
