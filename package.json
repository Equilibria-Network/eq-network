{
  "name": "@eq-network/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --filter @eq-network/site dev",
    "dev:playground": "pnpm --filter @eq-network/playground dev",
    "build": "pnpm -r --if-present build",
    "preview": "pnpm --filter @eq-network/site preview",
    "preview:playground": "pnpm --filter @eq-network/playground preview",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.0.1",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.65.0"
  }
}
