{
  "name": "@eq-network/playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/embed.ts",
    "./embed": "./src/embed.ts"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
