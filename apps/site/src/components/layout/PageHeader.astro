---
export interface PageHeaderMeta {
  label: string;
  value: string;
}

interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  meta?: PageHeaderMeta[];
}

const { eyebrow, title, subtitle, description, image, imageAlt = '', meta = [] } = Astro.props;
---

<header class="pageHeader">
  <div class="inner">
    <div class="copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
      {description && <p class="description">{description}</p>}
    </div>

    {
      (image || meta.length > 0 || Astro.slots.has('visual')) && (
        <div class="aside">
          {Astro.slots.has('visual') ? (
            <slot name="visual" />
          ) : (
            image && <img src={image} alt={imageAlt} width="260" height="260" />
          )}
          {meta.length > 0 && (
            <dl>
              {meta.map((item) => (
                <div>
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      )
    }
  </div>
</header>

<style>
  .pageHeader {
    --header-ink: #003b7e;
    --header-line: rgba(0, 59, 126, 0.17);
    border-block: 1px solid var(--header-line);
    color: #0b1f3a;
    background:
      repeating-linear-gradient(
        45deg,
        rgba(0, 59, 126, 0.04) 0,
        rgba(0, 59, 126, 0.04) 1px,
        transparent 1px,
        transparent 10px
      ),
      #fff;
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 0.34fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    width: min(1180px, 100%);
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, 5.5rem) 1.5rem;
  }

  .copy {
    max-width: 820px;
  }

  .eyebrow,
  dt {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: #4ab3f4;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--header-ink);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(3.2rem, 7vw, 6.5rem);
    line-height: 0.94;
    letter-spacing: -0.06em;
  }

  .subtitle {
    margin-top: 1.25rem;
    color: var(--header-ink);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(1.2rem, 2.4vw, 1.75rem);
    font-weight: 600;
    line-height: 1.35;
  }

  .description {
    max-width: 720px;
    margin-top: 1rem;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .aside {
    display: grid;
    gap: 1.25rem;
    justify-items: end;
  }

  .aside img {
    width: min(230px, 100%);
    height: auto;
  }

  dl {
    width: min(100%, 300px);
    border: 1px solid var(--header-line);
    background: #fff;
  }

  dl div {
    display: grid;
    grid-template-columns: minmax(90px, 0.8fr) 1.2fr;
    gap: 1rem;
    padding: 0.65rem 0.8rem;
  }

  dl div + div {
    border-top: 1px solid var(--header-line);
  }

  dt {
    color: rgba(0, 31, 69, 0.55);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--header-ink);
    font-size: 0.78rem;
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .inner {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .aside {
      width: 100%;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: end;
      justify-items: start;
    }

    .aside img {
      width: 110px;
    }

    dl {
      justify-self: stretch;
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .aside {
      grid-template-columns: 1fr;
    }
  }
</style>
