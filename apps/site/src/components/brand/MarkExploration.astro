---
import { lorenzMarkCandidates as candidates } from './lorenzMarks';
import LorenzMark from './LorenzMark.astro';

const shortlist = ['04', '02', '07']
  .map((id) => candidates.find((candidate) => candidate.id === id))
  .filter((candidate) => candidate !== undefined);
---

<section class="markLab" id="mark-lab">
  <div class="rule"><span>01 / MARK EXPLORATION</span></div>
  <header class="labIntro">
    <div>
      <p class="eyebrow">ONE LINE / MANY DYNAMICS</p>
      <h2>The mark is no longer assumed to be symmetrical.</h2>
    </div>
    <div>
      <p>
        Every candidate is generated by the same Lorenz system used on the home page. The phase and
        sampling window reveal unequal basins; nearby parameter studies test proportion without
        replacing the underlying mathematics with invented curves.
      </p>
      <p class="handNote">select the motion first; tune the exact curve second</p>
    </div>
  </header>

  <div class="candidateGrid">
    {
      shortlist.map((candidate) => (
        <article class="candidate">
          <div class="candidateMeta">
            <span>{candidate.id}</span>
            <strong>{candidate.name}</strong>
          </div>
          <svg viewBox="0 0 240 240" role="img" aria-label={`${candidate.name} mark candidate`}>
            <LorenzMark strokes={candidate.strokes} />
          </svg>
          <small>{candidate.params}</small>
          <p>{candidate.note}</p>
          <div class="scaleTest" aria-label="Scale test">
            <svg viewBox="0 0 240 240" aria-hidden="true">
              <LorenzMark strokes={candidate.strokes} />
            </svg>
            <svg viewBox="0 0 240 240" aria-hidden="true">
              <LorenzMark strokes={candidate.strokes} />
            </svg>
            <svg viewBox="0 0 240 240" aria-hidden="true">
              <LorenzMark strokes={candidate.strokes} />
            </svg>
          </div>
        </article>
      ))
    }
  </div>

  <div class="contextStrip">
    <div class="contextMark">
      <span>CONTEXT / WORDMARK</span>
      <svg viewBox="0 0 240 240" aria-hidden="true"
        ><LorenzMark strokes={candidates[3].strokes} /></svg
      >
      <strong>Equilibria</strong>
    </div>
    <div class="contextMark reversed">
      <span>CONTEXT / REVERSED</span>
      <svg viewBox="0 0 240 240" aria-hidden="true"
        ><LorenzMark strokes={candidates[3].strokes} /></svg
      >
      <strong>EQ</strong>
    </div>
    <p>
      Candidate 04 is shown only as a scale/context placeholder. No candidate is promoted to the
      production mark until selected and optically refined.
    </p>
  </div>
</section>

<style>
  .markLab {
    padding-block: clamp(5rem, 9vw, 9rem);
  }

  .rule {
    border-top: 1px solid var(--ink);
    margin-bottom: 3rem;
    font-size: 0.63rem;
  }

  .rule span {
    position: relative;
    top: -0.65em;
    padding-right: 1rem;
    background: var(--paper);
  }

  .labIntro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.7fr);
    gap: clamp(2rem, 7vw, 7rem);
    margin-bottom: clamp(3rem, 6vw, 6rem);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--accent);
    font-size: 0.66rem;
  }

  h2 {
    max-width: 14ch;
    margin: 0;
    font:
      500 clamp(2.4rem, 5vw, 5.2rem)/0.95 'Space Grotesk',
      sans-serif;
    letter-spacing: -0.06em;
  }

  .labIntro > div:last-child {
    align-self: end;
    color: var(--graphite);
    line-height: 1.7;
  }

  .handNote {
    margin: 1.5rem 0 0 2rem;
    font:
      400 1.2rem 'Kalam',
      cursive;
    transform: rotate(-1deg);
  }

  .candidateGrid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .candidate {
    min-width: 0;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 1rem;
  }

  .candidateMeta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font:
      0.57rem/1 'IBM Plex Mono',
      monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .candidate > svg {
    display: block;
    width: 100%;
    max-height: 230px;
    margin-block: 0.75rem;
  }

  .candidate svg,
  .contextMark svg {
    color: var(--ink);
    --mark-width: 4.5;
  }

  .candidate > p {
    min-height: 2.8em;
    margin: 0;
    color: var(--graphite);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .candidate > small {
    display: block;
    margin-bottom: 0.55rem;
    color: var(--accent);
    font:
      0.52rem/1 'IBM Plex Mono',
      monospace;
    letter-spacing: 0.04em;
  }

  .scaleTest {
    display: flex;
    align-items: end;
    gap: 0.65rem;
    border-top: 1px solid var(--line);
    margin-top: 1rem;
    padding-top: 0.75rem;
  }

  .scaleTest svg:nth-child(1) {
    width: 48px;
  }
  .scaleTest svg:nth-child(2) {
    width: 32px;
  }
  .scaleTest svg:nth-child(3) {
    width: 20px;
  }
  .scaleTest svg {
    --mark-width: 7;
  }

  .contextStrip {
    display: grid;
    grid-template-columns: 1fr 0.7fr 1fr;
    margin-top: 2rem;
    border: 1px solid var(--ink);
  }

  .contextMark {
    display: grid;
    grid-template-columns: auto 62px 1fr;
    gap: 1rem;
    align-items: center;
    padding: 1rem;
  }

  .contextMark > span {
    grid-column: 1 / -1;
    font:
      0.55rem/1 'IBM Plex Mono',
      monospace;
  }

  .contextMark svg {
    width: 62px;
  }

  .contextMark strong {
    font:
      500 clamp(1.8rem, 3vw, 3.5rem)/1 'Space Grotesk',
      sans-serif;
    letter-spacing: -0.05em;
  }

  .reversed {
    background: var(--ink);
    color: var(--paper);
  }

  .reversed svg {
    color: var(--paper);
  }

  .contextStrip > p {
    align-self: center;
    margin: 0;
    padding: 1.5rem;
    color: var(--graphite);
    line-height: 1.6;
  }

  @media (max-width: 1050px) {
    .candidateGrid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .labIntro,
    .contextStrip {
      grid-template-columns: 1fr;
    }

    .candidateGrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 460px) {
    .candidateGrid {
      grid-template-columns: 1fr;
    }
  }
</style>
