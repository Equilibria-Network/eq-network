---
// src/components/roadmap/PipelinePrototype.astro
// Six-track development-pipeline prototype for /roadmap/prototype (task-0009).
// Pipeline visualization: one lane per track, milestones as nodes on the lane.
// Static editorial page: no island, readable without JS, no motion.
import PageHeader from '@components/layout/PageHeader.astro';
import { pipelinePrototypeContent } from '@content/roadmap/tracks';
import type { MilestoneStatus } from '@content/roadmap/tracks';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

const { header, ui, phases, tracksIntro, tracks, loop } = pipelinePrototypeContent;
const [phaseNow, phaseAfter] = phases;

const headerMeta = [
  { label: 'Phase', value: phaseNow.name },
  { label: 'Tracks', value: String(tracks.length) },
];

const legendOrder: MilestoneStatus[] = ['done', 'active', 'next', 'later'];
---

<article class="pipelinePrototype">
  <PageHeader {...header} meta={headerMeta} />

  <div class="container">
    <section aria-labelledby="pipeline-phases-label">
      <div class="rule">
        <span class="ruleLabel" id="pipeline-phases-label">{ui.phasesRuleLabel}</span>
      </div>

      <div class="phaseBand">
        <div class="phaseCell">
          <div class="strip">
            <span>{phaseNow.label}</span>
          </div>
          <h2>{phaseNow.name}</h2>
          <p>{phaseNow.note}</p>
        </div>
        <div class="phaseArrow" aria-hidden="true">→</div>
        <span class="sr-only">followed by</span>
        <div class="phaseCell">
          <div class="strip">
            <span>{phaseAfter.label}</span>
          </div>
          <h2>{phaseAfter.name}</h2>
          <p>{phaseAfter.note}</p>
        </div>
      </div>
    </section>

    <section aria-labelledby="pipeline-tracks-label">
      <div class="rule">
        <span class="ruleLabel" id="pipeline-tracks-label">{ui.tracksRuleLabel}</span>
      </div>

      <div class="tracksTop">
        <p class="tracksIntro">{tracksIntro}</p>

        <dl class="legend">
          <dt>{ui.legendLabel}</dt>
          {
            legendOrder.map((status) => (
              <dd>
                <span class:list={['node', status]} aria-hidden="true" />
                {ui.statusLabels[status]}
              </dd>
            ))
          }
        </dl>
      </div>

      <div class="lanes">
        {
          tracks.map((track) => (
            <div class="lane" id={`track-${track.id}`}>
              <div class="laneHead">
                <span class="laneIndex">
                  {ui.trackLabelPrefix}
                  {track.index}
                </span>
                <h3>{track.name}</h3>
                <p class="question">{track.question}</p>
              </div>
              <div class="laneScroller">
                <ol class="laneLine">
                  {track.milestones.map((milestone) => (
                    <li class="milestone">
                      <span class:list={['node', milestone.status]} aria-hidden="true" />
                      <span class="mLabel">{milestone.label}</span>
                      <span class="mStatus">{ui.statusLabels[milestone.status]}</span>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="pipeline-loop-label">
      <div class="rule">
        <span class="ruleLabel" id="pipeline-loop-label">{ui.loopRuleLabel}</span>
      </div>

      <div class="loop">
        <h2>{loop.title}</h2>
        <p>{loop.body}</p>
      </div>
    </section>
  </div>
</article>

<style>
  .pipelinePrototype {
    --line: rgba(0, 59, 126, 0.17);
    --line-quiet: rgba(0, 59, 126, 0.1);
    --hatch: repeating-linear-gradient(
      45deg,
      rgba(0, 59, 126, 0.05) 0,
      rgba(0, 59, 126, 0.05) 1px,
      transparent 1px,
      transparent 8px
    );
    --node-hatch: repeating-linear-gradient(
      45deg,
      rgba(0, 59, 126, 0.55) 0,
      rgba(0, 59, 126, 0.55) 1px,
      transparent 1px,
      transparent 4px
    );
    background: #fff;
  }

  .container {
    width: min(1180px, 100%);
    margin-inline: auto;
    padding: 0 1.5rem 6rem;
  }

  /* Annotated rule: a hairline with a mono label riding on it. */
  .rule {
    position: relative;
    margin: 5rem 0 2.5rem;
    border-top: 1px solid var(--line);
  }

  .ruleLabel {
    position: absolute;
    top: 0;
    left: 0;
    transform: translateY(-50%);
    padding-right: 0.9rem;
    background: #fff;
    color: var(--color-primary);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* Hatched information strip on the phase cells. */
  .strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.9rem;
    border-bottom: 1px solid var(--line-quiet);
    background: var(--hatch);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  /* The two-phase band. */
  .phaseBand {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 1.25rem;
  }

  .phaseCell {
    border: 1px solid var(--line);
    background: #fff;
  }

  .phaseCell h2 {
    margin: 1.1rem 0.9rem 0;
    color: var(--color-primary);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .phaseCell p {
    margin: 0.6rem 0.9rem 1.1rem;
    font-size: 0.95rem;
    line-height: 1.7;
    opacity: 0.85;
  }

  .phaseArrow {
    align-self: center;
    color: var(--color-primary);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 1.5rem;
  }

  /* Intro + legend row. */
  .tracksTop {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .tracksIntro {
    max-width: 620px;
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .legend {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin: 0;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line-quiet);
  }

  .legend dt,
  .legend dd {
    margin: 0;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .legend dt {
    opacity: 0.65;
  }

  .legend dd {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  /* Milestone node: square, flat, state shown by fill. */
  .node {
    flex: none;
    width: 14px;
    height: 14px;
    border: 1px solid var(--color-primary);
    background: #fff;
  }

  .node.done {
    background: var(--color-primary);
  }

  .node.active {
    background: var(--node-hatch);
  }

  .node.later {
    border-style: dashed;
  }

  /* Track lanes. */
  .lane {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .lane + .lane {
    margin-top: 2.75rem;
    padding-top: 2.75rem;
    border-top: 1px solid var(--line-quiet);
  }

  .laneIndex {
    display: block;
    color: var(--color-primary);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .laneHead h3 {
    margin: 0.45rem 0 0;
    color: var(--color-primary);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .question {
    margin: 0.5rem 0 0;
    color: var(--color-primary);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.74rem;
    line-height: 1.5;
    opacity: 0.85;
  }

  /* The lane itself: a horizontal line the milestone nodes sit on.
     Scrolls inside its own container on narrow viewports. */
  .laneScroller {
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }

  .laneLine {
    position: relative;
    display: flex;
    min-width: 100%;
    margin: 0;
    padding: 0.35rem 2.25rem 0 0;
    list-style: none;
  }

  /* The track line, drawn behind the nodes, continuing into an open arrow. */
  .laneLine::before {
    content: '';
    position: absolute;
    top: calc(0.35rem + 7px);
    left: 0;
    right: 0.9rem;
    border-top: 1px solid var(--line);
  }

  .laneLine::after {
    content: '→';
    position: absolute;
    top: calc(0.35rem + 7px);
    right: 0;
    transform: translateY(-52%);
    color: var(--color-primary);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.9rem;
    opacity: 0.65;
  }

  .milestone {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1 1 8rem;
    min-width: 8rem;
    padding-right: 1.25rem;
  }

  .milestone .node {
    position: relative;
    z-index: 1;
  }

  .mLabel {
    margin-top: 0.55rem;
    max-width: 8.25rem;
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .mStatus {
    margin-top: 0.3rem;
    color: var(--color-primary);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  /* Closing-the-loop section. */
  .loop {
    max-width: 820px;
  }

  .loop h2 {
    margin: 0;
    color: var(--color-primary);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .loop p {
    margin-top: 1rem;
    font-size: 1.125rem;
    line-height: 1.7;
  }

  @media (max-width: 992px) {
    .lane {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .lane + .lane {
      margin-top: 2.25rem;
      padding-top: 2.25rem;
    }
  }

  @media (max-width: 760px) {
    .phaseBand {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .phaseArrow {
      justify-self: center;
      transform: rotate(90deg);
    }

    .rule {
      margin-top: 3.5rem;
    }
  }
</style>
