---
// src/layouts/Layout.astro
import Navbar from '@components/layout/Navbar';
import Footer from '@components/layout/Footer';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Equilibria Network',
  description = 'Exploring the design space of collective intelligence through simulations and mathematical foundations.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph (a raster og:image is a follow-up; no social card asset exists yet) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Equilibria Network" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
  </head>
  <body>
    <!-- Parallax Background Pattern -->
    <div class="parallax-background"></div>

    <a class="skip-link" href="#main-content">Skip to content</a>

    <!-- Navbar -->
    <header>
      <Navbar client:load currentPath={Astro.url.pathname} />
    </header>

    <!-- Main Content -->
    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <!-- Footer -->
    <Footer client:load />
  </body>
</html>
