---
import PlaygroundApp from '@eq-network/playground/embed';
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@components/layout/PageHeader.astro';
---

<Layout
  seo={{
    title: 'Collective Intelligence Playground — Equilibria Network',
    description:
      'Configure and compare five browser simulations of economic, cultural, and political power under AI-driven change.',
    canonicalPath: '/lab/playground',
    noindex: true,
  }}
>
  <PageHeader
    eyebrow="CI LAB / INTERACTIVE MODEL"
    title="Collective intelligence playground"
    subtitle="Five small worlds. One coupled question: who can still shape the system?"
    summary="Follow each scenario before changing it. The live models show how economic, cultural, and political feedback loops can alter collective agency; settings reveal the minimal agent-based machinery underneath."
    meta={[
      { label: 'Status', value: 'Explanatory model' },
      { label: 'Runtime', value: 'Your browser' },
    ]}
  />
  <PlaygroundApp client:load />
</Layout>
