---
// /lab/playground — the interactive playground, served as its own document.
//
// Deliberately NOT wrapped in Layout.astro: the prototype is a self-contained
// page (own styles, own fonts, owns the viewport) and the site's global.css
// would fight it (`body { background: transparent !important }`, universal
// resets, navbar/parallax assumptions). The single source of truth is
// prototypes/playground.html — the same file the private artifact publishes —
// imported raw at build time, so editing the prototype updates this page on
// the next build with no copying step.
//
// Unlisted by the same convention as /lab itself: absent from the navbar.
import playgroundHtml from '../../../prototypes/playground.html?raw';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CI Lab Playground — Equilibria Network</title>
    <meta
      name="description"
      content="Run the Lab's five toy scenarios of AI-driven disempowerment: 500-tick simulations, composable defenses, hand-drawn live views."
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body>
    <div style="max-width: 1160px; margin: 12px auto 0; padding: 0 32px; font-family: 'Segoe Print', 'Bradley Hand', 'Comic Sans MS', cursive; font-size: 13px;">
      <a href="/lab" style="color: #003b7e; text-decoration: none;">← back to the lab</a>
    </div>
    <Fragment set:html={playgroundHtml} />
  </body>
</html>
