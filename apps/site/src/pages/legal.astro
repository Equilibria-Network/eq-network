---
import Layout from '@/layouts/Layout.astro';
import PageHeader from '@components/layout/PageHeader.astro';
import PageSidebar from '@components/layout/PageSidebar.astro';
import { legalContent } from '@content/legal';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-mono/400.css';

const { title, eyebrow, intro, details, sections, contact, registry } = legalContent;
const sidebarItems = [
  { label: 'Registered identity', href: '#registered-identity' },
  ...sections.map((section) => ({
    label: section.heading,
    href: `#${section.heading.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`,
  })),
  { label: contact.heading, href: '#formal-contact' },
];
---

<Layout
  title="Legal information — Equilibria Network"
  description="Legal identity, website operator, contact details, and public registration information for Equilibria Network."
>
  <section class="legal">
    <PageHeader
      {eyebrow}
      {title}
      summary={intro}
      image="/img/brand/marks/sym-concentric.svg"
      imageAlt=""
      meta={[
        { label: 'Status', value: 'Registered' },
        { label: 'Since', value: '12 June 2026' },
      ]}
    />

    <div class="documentGrid">
      <PageSidebar items={sidebarItems} />
      <div class="legalBody">
        <section class="identity" id="registered-identity" aria-labelledby="identity-heading">
          <div class="sectionRule">
            <span>01</span>
            <h2 id="identity-heading">Registered identity</h2>
          </div>
          <dl>
            {
              details.map((detail) => (
                <div>
                  <dt>{detail.label}</dt>
                  <dd>{detail.value}</dd>
                </div>
              ))
            }
          </dl>
          <div class="registry">
            <a href={registry.href} target="_blank" rel="noopener noreferrer">{registry.label} ↗</a>
            <p>{registry.note}</p>
          </div>
        </section>

        {
          sections.map((section, index) => (
            <section
              class="textSection"
              id={section.heading.toLowerCase().replace(/[^a-z0-9]+/g, '-')}
            >
              <div class="sectionRule">
                <span>{String(index + 2).padStart(2, '0')}</span>
                <h2>{section.heading}</h2>
              </div>
              <div class="paragraphs">
                {section.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
                {section.heading === 'Privacy' && <a href="/privacy">Read the Privacy Policy →</a>}
                {section.links?.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label} ↗
                  </a>
                ))}
              </div>
            </section>
          ))
        }

        <section class="contact textSection" id="formal-contact">
          <div class="sectionRule">
            <span>{String(sections.length + 2).padStart(2, '0')}</span>
            <h2>{contact.heading}</h2>
          </div>
          <p>
            {contact.body}{' '}
            <a href={`mailto:${contact.email}`}>{contact.email}</a>.
          </p>
        </section>
      </div>
    </div>
  </section>
</Layout>

<style>
  .legal {
    --ink: #003b7e;
    --line: rgba(0, 59, 126, 0.17);
    color: #0b1f3a;
    padding: 0 0 5rem;
  }

  .documentGrid {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    width: min(1180px, 100%);
    margin-inline: auto;
    border-inline: 1px solid var(--line);
  }

  .sectionRule span,
  dt {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
  }

  h2 {
    color: var(--ink);
    font-family: 'Space Grotesk', system-ui, sans-serif;
  }

  .legalBody {
    min-width: 0;
    padding-inline: clamp(1.5rem, 5vw, 4rem);
  }

  .identity,
  .textSection,
  .contact {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .sectionRule {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
    margin-bottom: 2rem;
  }

  .sectionRule span {
    color: #4ab3f4;
    font-size: 0.72rem;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    letter-spacing: -0.03em;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  dl div {
    min-height: 130px;
    padding: 1.25rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  dt {
    margin-bottom: 1.5rem;
    color: rgba(0, 31, 69, 0.58);
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  dd {
    color: var(--ink);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 600;
  }

  .registry {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.25rem;
    font-size: 0.88rem;
  }

  .registry p {
    max-width: 430px;
    color: rgba(0, 31, 69, 0.62);
    text-align: right;
  }

  .textSection {
    display: grid;
    grid-template-columns: minmax(260px, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 7vw, 7rem);
  }

  .paragraphs p,
  .contact p {
    font-size: 1.03rem;
    line-height: 1.75;
  }

  .paragraphs p + p {
    margin-top: 1rem;
  }

  .paragraphs a,
  .registry a {
    display: inline-block;
    margin-top: 1rem;
    border-bottom: 1px solid currentColor;
    font-weight: 650;
  }

  .contact a {
    border-bottom: 1px solid currentColor;
    font-weight: 650;
  }

  @media (max-width: 720px) {
    .documentGrid {
      grid-template-columns: 1fr;
    }

    dl {
      grid-template-columns: 1fr;
    }

    .registry,
    .textSection {
      display: block;
    }

    .registry p {
      margin-top: 1rem;
      text-align: left;
    }
  }
</style>
