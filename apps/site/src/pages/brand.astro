---
// src/pages/brand.astro
// PROTOTYPE brand exploration — the "blueprint / measured" direction. Not the
// settled brand. Layout via Tailwind utilities; the blueprint motifs (hairline
// frame, corner ticks, diagonal hatch, hatched card, annotated rule) are the
// bespoke scoped-CSS layer. Copy/data in src/content/brand.ts.
import Layout from '@/layouts/Layout.astro';
import { brandContent } from '@content/brand';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

const b = brandContent;
---

<Layout
  title="Brand (prototype) - Equilibria Network"
  description="A prototype exploration of the Equilibria Network identity: a measured, blueprint direction built on the Lorenz attractor and the hatched card."
>
  <div class="bp">
    <!-- prototype banner -->
    <div class="proto-banner ff-mono">{b.prototypeNote}</div>
    <nav class="proto-switch ff-mono">
      <span>proto /</span>
      <a href="/brand" aria-current="page">A · blueprint</a>
      <a href="/brand/b">B · engineering</a>
      <a href="/brand/c">C · cyanotype</a>
      <a href="/brand/d">D · minimal</a>
      <a href="/brand/elements">elements</a>
    </nav>

    <div class="sheet">
      <!-- Hero -->
      <header class="hero">
        <span class="tag ff-mono">{b.eyebrow}</span>
        <div class="hero-grid">
          <div class="hero-mark">
            <img
              src="/img/brand/marks/v-contour.svg"
              alt="Equilibria Lorenz mark"
              width="200"
              height="200"
            />
          </div>
          <div class="hero-lead">
            <h1 class="ff-display wordmark">{b.wordmark}</h1>
            <p class="ff-display tagline">{b.tagline}</p>
            <p class="intro">{b.intro}</p>
          </div>
        </div>
        <div class="system ff-mono">
          <span class="system-tag">// {b.system.tag}</span>
          <div class="system-eq">
            {b.system.equations.map((e) => <span>{e}</span>)}
          </div>
          <span class="system-params">{b.system.params}</span>
        </div>
      </header>

      <!-- Mark -->
      <section>
        <div class="rule ff-mono"><span>{b.sections.mark}</span></div>
        <p class="section-intro">{b.markIntro}</p>
        <div class="mark-grid">
          {
            b.marks.map((m) => (
              <figure class={`mark-cell ${m.dark ? 'is-dark' : 'is-hatch'}`}>
                <img src={m.src} alt={m.label} width="120" height="120" loading="lazy" />
                <figcaption>
                  <span class="ff-mono mark-label">{m.label}</span>
                  <span class="mark-note">{m.note}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <!-- Colour -->
      <section>
        <div class="rule ff-mono"><span>{b.sections.colour}</span></div>
        <div class="swatch-grid">
          {
            b.swatches.map((s) => (
              <div class="swatch">
                <div
                  class="chip"
                  style={`background:${s.hex.length > 7 ? '#003B7E' : s.hex};${s.hex.length > 7 ? 'opacity:.15;' : ''}`}
                />
                <div class="swatch-meta ff-mono">
                  <span class="swatch-hex">{s.hex}</span>
                  <span class="swatch-name">{s.name}</span>
                  <span class="swatch-role">{s.role}</span>
                </div>
              </div>
            ))
          }
        </div>
        <p class="section-intro">{b.colourNote}</p>
      </section>

      <!-- Type -->
      <section>
        <div class="rule ff-mono"><span>{b.sections.type}</span></div>
        <div class="type-stack">
          {
            b.faces.map((f) => (
              <div class="face">
                <span class="ff-mono face-role">
                  [ {f.role} ] {f.name}
                </span>
                <p class={`${f.fontClass} face-sample`}>{f.sample}</p>
                <p class="face-usage">{f.usage}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- System / motifs -->
      <section>
        <div class="rule ff-mono"><span>{b.sections.motifs}</span></div>
        <div class="motif-grid">
          {
            b.motifs.map((m) => (
              <div class="hatched-card">
                <span class="ff-mono card-tag">{m.tag}</span>
                <strong class="ff-display card-title">{m.title}</strong>
                <p class="card-body">{m.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Closing -->
      <section class="closing">
        <div class="rule ff-mono"><span>{b.closing.title}</span></div>
        <p class="closing-body">
          {b.closing.body}<a class="ff-mono" href={`mailto:${b.closing.email}`}>{b.closing.email}</a
          >.
        </p>
      </section>
    </div>
  </div>

  <style>
    /* ============ blueprint / measured prototype ============ */
    .bp {
      --ink: #003b7e;
      --accent: #4ab3f4;
      --void: #0b1f3a;
      --paper: #ffffff;
      --line: rgba(0, 59, 126, 0.16);
      --hatch: rgba(0, 59, 126, 0.06);
      background: var(--paper);
      color: var(--ink);
    }
    .ff-display {
      font-family: 'Space Grotesk', system-ui, sans-serif;
    }
    .ff-mono {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
    }

    .proto-banner {
      background: var(--void);
      color: #fff;
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      text-align: center;
      padding: 0.55rem 1rem;
    }
    .proto-switch {
      display: flex;
      flex-wrap: wrap;
      gap: 1.25rem;
      align-items: center;
      justify-content: center;
      padding: 0.6rem 1rem;
      border-bottom: 1px solid var(--line);
      font-size: 0.72rem;
      background: #fff;
    }
    .proto-switch span {
      opacity: 0.5;
    }
    .proto-switch a {
      color: var(--ink);
      text-decoration: none;
      opacity: 0.7;
    }
    .proto-switch a:hover {
      opacity: 1;
    }
    .proto-switch a[aria-current='page'] {
      opacity: 1;
      border-bottom: 2px solid var(--accent);
      padding-bottom: 2px;
    }

    /* The drawn sheet: hatched ground + hairline frame with corner ticks */
    .sheet {
      position: relative;
      max-width: 1120px;
      margin: 0 auto;
      padding: 4.5rem 3.5rem 5rem;
      background: var(--paper);
    }
    .sheet::before {
      content: '';
      position: absolute;
      inset: 1.5rem;
      border: 1px solid var(--line);
      pointer-events: none;
    }
    /* corner ticks */
    .sheet::after {
      content: '';
      position: absolute;
      inset: 1.5rem;
      pointer-events: none;
      background:
        linear-gradient(var(--ink), var(--ink)) left top / 14px 1px no-repeat,
        linear-gradient(var(--ink), var(--ink)) left top / 1px 14px no-repeat,
        linear-gradient(var(--ink), var(--ink)) right top / 14px 1px no-repeat,
        linear-gradient(var(--ink), var(--ink)) right top / 1px 14px no-repeat,
        linear-gradient(var(--ink), var(--ink)) left bottom / 14px 1px no-repeat,
        linear-gradient(var(--ink), var(--ink)) left bottom / 1px 14px no-repeat,
        linear-gradient(var(--ink), var(--ink)) right bottom / 14px 1px no-repeat,
        linear-gradient(var(--ink), var(--ink)) right bottom / 1px 14px no-repeat;
    }

    .tag {
      display: inline-block;
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink);
      opacity: 0.7;
      border: 1px solid var(--line);
      padding: 0.25rem 0.6rem;
    }

    /* Hero */
    .hero {
      margin-bottom: 4.5rem;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 2.5rem;
      align-items: center;
      margin-top: 1.75rem;
    }
    .hero-mark {
      border: 1px solid var(--line);
      background: #fff;
      aspect-ratio: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .hero-mark img {
      width: 74%;
      height: auto;
    }
    .wordmark {
      font-size: clamp(3rem, 8vw, 5.5rem);
      font-weight: 700;
      line-height: 0.95;
      letter-spacing: -0.03em;
    }
    .tagline {
      font-size: clamp(1.1rem, 2.4vw, 1.6rem);
      font-weight: 500;
      margin-top: 0.6rem;
      opacity: 0.9;
    }
    .intro {
      max-width: 54ch;
      margin-top: 1.25rem;
      font-size: 1.02rem;
      line-height: 1.65;
      color: var(--void);
      opacity: 0.85;
    }
    .system {
      margin-top: 2.5rem;
      border: 1px solid var(--line);
      background: #fff;
      padding: 1.1rem 1.35rem;
      font-size: 0.85rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.6rem 2rem;
    }
    .system-tag {
      opacity: 0.6;
    }
    .system-eq {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      color: var(--ink);
    }
    .system-params {
      color: var(--accent);
      margin-left: auto;
    }

    /* Annotated rule (section header) */
    .rule {
      position: relative;
      border-top: 1px solid var(--ink);
      margin: 3.25rem 0 1.5rem;
    }
    .rule span {
      position: absolute;
      top: -0.75rem;
      left: 0;
      background: var(--paper);
      padding-right: 0.75rem;
      font-size: 0.75rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .section-intro {
      max-width: 62ch;
      font-size: 0.98rem;
      line-height: 1.6;
      opacity: 0.8;
      margin-bottom: 1.75rem;
    }

    /* Mark grid */
    .mark-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    .mark-cell {
      border: 1px solid var(--line);
      display: flex;
      flex-direction: column;
    }
    .mark-cell img {
      width: 100%;
      height: 150px;
      object-fit: contain;
      padding: 1.5rem;
    }
    .mark-cell.is-hatch img {
      background-image: repeating-linear-gradient(
        45deg,
        var(--hatch) 0,
        var(--hatch) 1px,
        transparent 1px,
        transparent 8px
      );
    }
    .mark-cell.is-dark {
      background: var(--void);
    }
    .mark-cell figcaption {
      border-top: 1px solid var(--line);
      padding: 0.7rem 0.85rem 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      background: #fff;
    }
    .mark-label {
      font-size: 0.72rem;
      color: var(--ink);
    }
    .mark-note {
      font-size: 0.8rem;
      line-height: 1.4;
      opacity: 0.65;
    }

    /* Colour */
    .swatch-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 1rem;
    }
    .swatch {
      border: 1px solid var(--line);
    }
    .chip {
      height: 90px;
    }
    .swatch-meta {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      padding: 0.7rem 0.8rem 0.85rem;
      border-top: 1px solid var(--line);
      background: #fff;
    }
    .swatch-hex {
      font-size: 0.75rem;
      color: var(--ink);
    }
    .swatch-name {
      font-size: 0.82rem;
      font-weight: 500;
    }
    .swatch-role {
      font-size: 0.75rem;
      opacity: 0.6;
      line-height: 1.35;
    }

    /* Type */
    .type-stack {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    .face {
      border-left: 1px solid var(--ink);
      padding-left: 1.25rem;
    }
    .face-role {
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      opacity: 0.6;
    }
    .face-sample {
      font-size: clamp(2rem, 5vw, 3.25rem);
      line-height: 1.1;
      margin: 0.35rem 0 0.5rem;
    }
    .face-usage {
      font-size: 0.9rem;
      line-height: 1.55;
      opacity: 0.75;
      max-width: 60ch;
    }

    /* Hatched cards */
    .motif-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    .hatched-card {
      position: relative;
      border: 1px solid var(--line);
      padding: 1.5rem 1.5rem 1.6rem;
      background-color: #fff;
      background-image: repeating-linear-gradient(
        45deg,
        var(--hatch) 0,
        var(--hatch) 1px,
        transparent 1px,
        transparent 8px
      );
    }
    .card-tag {
      position: absolute;
      top: 0.8rem;
      right: 0.9rem;
      font-size: 0.72rem;
      opacity: 0.5;
    }
    .card-title {
      display: block;
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: 0.4rem;
    }
    .card-body {
      font-size: 0.92rem;
      line-height: 1.55;
      color: var(--void);
      opacity: 0.82;
      max-width: 46ch;
    }

    /* Closing */
    .closing-body {
      font-size: 1.05rem;
      line-height: 1.6;
    }
    .closing-body a {
      color: var(--ink);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    @media (max-width: 820px) {
      .sheet {
        padding: 3rem 1.5rem 3.5rem;
      }
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
      .hero-mark {
        width: 140px;
      }
      .mark-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .swatch-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .motif-grid {
        grid-template-columns: 1fr;
      }
      .system-params {
        margin-left: 0;
      }
    }
  </style>
</Layout>
