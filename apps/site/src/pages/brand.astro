---
// src/pages/brand.astro
// Canonical Equilibria visual-identity page. Editorial white space is combined
// with restrained engineering-drawing structure, dimensions, and localized
// technical texture. Copy/data lives in src/content/brand.ts.
import Layout from '@/layouts/Layout.astro';
import { brandContent } from '@content/brand';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

const b = brandContent;
---

<Layout
  title="Brand - Equilibria Network"
  description="The Equilibria Network visual identity: mark, colour, typography, components, and usage guidance."
>
  <div class="bp">
    <div class="drawing">
      <span class="reg reg-tl" aria-hidden="true"></span>
      <span class="reg reg-tr" aria-hidden="true"></span>
      <span class="reg reg-bl" aria-hidden="true"></span>
      <span class="reg reg-br" aria-hidden="true"></span>

      <div class="drawing-head ff-mono">
        <span>{b.drawing.sheetLabel}</span>
        <span>{b.drawing.revision}</span>
      </div>

      <div class="sheet">
        <!-- Hero -->
        <header class="hero">
          <span class="tag ff-mono">{b.eyebrow}</span>
          <div class="hero-grid">
            <div class="mark-drawing">
              <span class="figure-label ff-mono">{b.drawing.figureLabel}</span>
              <div class="dim-v ff-mono" aria-hidden="true"><span>160</span></div>
              <div class="hero-mark">
                <span class="crosshair" aria-hidden="true"></span>
                <img
                  src="/img/brand/marks/sym-concentric.svg"
                  alt="Equilibria Lorenz mark"
                  width="200"
                  height="200"
                />
              </div>
              <div class="dim-h ff-mono"><span>{b.drawing.markMeasurement}</span></div>
            </div>
            <div class="hero-lead">
              <h1 class="ff-display wordmark">{b.wordmark}</h1>
              <p class="ff-display tagline">{b.tagline}</p>
              <p class="intro">{b.intro}</p>
            </div>
          </div>
          <div class="system ff-mono">
            <span class="system-tag">// {b.system.tag}</span>
            <div class="system-eq">
              {b.system.equations.map((e) => <span>{e}</span>)}
            </div>
            <span class="system-params">{b.system.params}</span>
          </div>
        </header>

        <!-- Mark -->
        <section>
          <div class="rule ff-mono"><span>{b.sections.mark}</span></div>
          <p class="section-intro">{b.markIntro}</p>
          <div class="mark-grid">
            {
              b.marks.map((m) => (
                <figure class={`mark-cell ${m.dark ? 'is-dark' : 'is-hatch'}`}>
                  <img src={m.src} alt={m.label} width="120" height="120" loading="lazy" />
                  <figcaption>
                    <span class="ff-mono mark-label">{m.label}</span>
                    <span class="mark-note">{m.note}</span>
                  </figcaption>
                </figure>
              ))
            }
          </div>
          <div class="mark-actions ff-mono">
            {
              b.assets.map((asset) => (
                <a href={asset.href} download={asset.downloadName}>
                  {asset.label}
                </a>
              ))
            }
          </div>
          <div class="usage-grid">
            <div class="usage-intro">
              <span class="ff-mono usage-label">{b.usage.title}</span>
              <p>{b.usage.intro}</p>
            </div>
            <div class="usage-column">
              <span class="ff-mono usage-label">Do</span>
              <ul>
                {b.usage.dos.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="usage-column">
              <span class="ff-mono usage-label">Do not</span>
              <ul>
                {b.usage.donts.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </section>

        <!-- Colour -->
        <section>
          <div class="rule ff-mono"><span>{b.sections.colour}</span></div>
          <div class="swatch-grid">
            {
              b.swatches.map((s) => (
                <div class="swatch">
                  <div
                    class="chip"
                    style={`background:${s.hex.length > 7 ? '#003B7E' : s.hex};${s.hex.length > 7 ? 'opacity:.15;' : ''}`}
                  />
                  <div class="swatch-meta ff-mono">
                    <span class="swatch-hex">{s.hex}</span>
                    <span class="swatch-name">{s.name}</span>
                    <span class="swatch-role">{s.role}</span>
                  </div>
                </div>
              ))
            }
          </div>
          <p class="section-intro">{b.colourNote}</p>
        </section>

        <!-- Type -->
        <section>
          <div class="rule ff-mono"><span>{b.sections.type}</span></div>
          <div class="type-stack">
            {
              b.faces.map((f) => (
                <div class="face">
                  <span class="ff-mono face-role">
                    [ {f.role} ] {f.name}
                  </span>
                  <p class={`${f.fontClass} face-sample`}>{f.sample}</p>
                  <p class="face-usage">{f.usage}</p>
                </div>
              ))
            }
          </div>
        </section>

        <!-- System / motifs -->
        <section>
          <div class="rule ff-mono"><span>{b.sections.motifs}</span></div>
          <div class="motif-grid">
            {
              b.motifs.map((m) => (
                <div class="hatched-card">
                  <span class="ff-mono card-tag">{m.tag}</span>
                  <strong class="ff-display card-title">{m.title}</strong>
                  <p class="card-body">{m.body}</p>
                </div>
              ))
            }
          </div>
        </section>

        <!-- Applied components -->
        <section>
          <div class="rule ff-mono"><span>{b.components.sectionTitle}</span></div>
          <p class="section-intro">{b.components.intro}</p>
          <div class="component-grid">
            <figure class="component-specimen">
              <article class="research-card">
                <div class="research-head ff-mono">
                  <span>{b.components.card.phase}</span>
                  <span>{b.components.card.reference}</span>
                </div>
                <div class="research-body">
                  <h3 class="ff-display research-title">{b.components.card.title}</h3>
                  <p>{b.components.card.abstract}</p>
                  <span class="ff-mono research-status">{b.components.card.status}</span>
                </div>
              </article>
              <figcaption class="ff-mono specimen-caption">{b.components.card.caption}</figcaption>
            </figure>

            <div class="tooltip-specimen">
              <span class="ff-mono specimen-label">{b.components.tooltips.title}</span>
              <p>{b.components.tooltips.intro}</p>
              <div class="tooltip-examples">
                {
                  b.components.tooltips.examples.map((example) => (
                    <p class="tooltip-line">
                      {example.before}{' '}
                      <span class="tooltip-term" tabindex="0">
                        {example.term}
                        <span class="tooltip-box ff-mono" role="tooltip">
                          {example.definition}
                        </span>
                      </span>{' '}
                      {example.after}
                    </p>
                  ))
                }
              </div>
            </div>
          </div>
        </section>

        <!-- Closing -->
        <section class="closing">
          <div class="rule ff-mono"><span>{b.closing.title}</span></div>
          <p class="closing-body">
            {b.closing.body}<a class="ff-mono" href={`mailto:${b.closing.email}`}
              >{b.closing.email}</a
            >.
          </p>
        </section>
      </div>

      <footer class="title-block ff-mono">
        {
          b.drawing.titleBlock.map((cell, index) => (
            <div class:list={['tb-cell', index < 2 && 'tb-wide', cell.accent && 'is-accent']}>
              <span class="tb-key">{cell.label}</span>
              <span class="tb-value">{cell.value}</span>
            </div>
          ))
        }
      </footer>
    </div>
  </div>

  <style>
    /* ============ blueprint / measured prototype ============ */
    .bp {
      --ink: #003b7e;
      --accent: #4ab3f4;
      --void: #0b1f3a;
      --paper: #ffffff;
      --line: rgba(0, 59, 126, 0.16);
      --hatch: rgba(0, 59, 126, 0.06);
      --grid-fine: rgba(0, 59, 126, 0.025);
      --grid-major: rgba(0, 59, 126, 0.055);
      background: var(--paper);
      color: var(--ink);
      padding-bottom: 2rem;
    }
    .ff-display {
      font-family: 'Space Grotesk', system-ui, sans-serif;
    }
    .ff-mono {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
    }

    /* Engineering drawing frame */
    .drawing {
      position: relative;
      max-width: 1180px;
      margin: 2rem auto 0;
      background-color: var(--paper);
      background-image: repeating-linear-gradient(
        45deg,
        var(--hatch) 0,
        var(--hatch) 1px,
        transparent 1px,
        transparent 8px
      );
      border: 1px solid var(--line);
    }
    .drawing-head {
      min-height: 38px;
      padding: 0.7rem 1.5rem;
      border-bottom: 1px solid var(--line);
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      background: #fff;
    }
    .sheet {
      position: relative;
      margin-inline: 18px;
      padding: 4.5rem 4rem 5rem;
      background: #fff;
    }
    .reg {
      position: absolute;
      z-index: 2;
      width: 22px;
      height: 22px;
      background:
        linear-gradient(var(--ink), var(--ink)) center / 100% 1px no-repeat,
        linear-gradient(var(--ink), var(--ink)) center / 1px 100% no-repeat;
      opacity: 0.75;
    }
    .reg::after {
      content: '';
      position: absolute;
      inset: 6px;
      border: 1px solid var(--ink);
      border-radius: 50%;
    }
    .reg-tl {
      top: -11px;
      left: -11px;
    }
    .reg-tr {
      top: -11px;
      right: -11px;
    }
    .reg-bl {
      bottom: -11px;
      left: -11px;
    }
    .reg-br {
      right: -11px;
      bottom: -11px;
    }

    .tag {
      display: inline-block;
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink);
      opacity: 0.7;
      border: 1px solid var(--line);
      padding: 0.25rem 0.6rem;
    }

    /* Hero */
    .hero {
      margin-bottom: 4.5rem;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 3.5rem;
      align-items: center;
      margin-top: 1.75rem;
    }
    .mark-drawing {
      position: relative;
      padding: 1.6rem 1.4rem 2rem 2rem;
    }
    .figure-label {
      position: absolute;
      top: 0;
      left: 2rem;
      font-size: 0.63rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      opacity: 0.58;
    }
    .hero-mark {
      position: relative;
      border: 1px solid var(--line);
      background-color: #fff;
      background-image:
        linear-gradient(var(--grid-major) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-major) 1px, transparent 1px),
        linear-gradient(var(--grid-fine) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-fine) 1px, transparent 1px);
      background-size:
        40px 40px,
        40px 40px,
        8px 8px,
        8px 8px;
      aspect-ratio: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .hero-mark img {
      position: relative;
      z-index: 1;
      width: 76%;
      height: auto;
    }
    .crosshair {
      position: absolute;
      inset: 12px;
      background:
        linear-gradient(var(--line), var(--line)) center / 100% 1px no-repeat,
        linear-gradient(var(--line), var(--line)) center / 1px 100% no-repeat;
    }
    .dim-v {
      position: absolute;
      top: 1.6rem;
      bottom: 2rem;
      left: 0;
      width: 1px;
      border-left: 1px solid var(--ink);
    }
    .dim-v::before,
    .dim-v::after {
      content: '';
      position: absolute;
      left: -4px;
      width: 8px;
      border-top: 1px solid var(--ink);
    }
    .dim-v::before {
      top: 0;
    }
    .dim-v::after {
      bottom: 0;
    }
    .dim-v span {
      position: absolute;
      top: 50%;
      left: -0.7rem;
      padding: 0.2rem 0;
      background: #fff;
      font-size: 0.62rem;
      transform: translateY(-50%) rotate(-90deg);
    }
    .dim-h {
      position: absolute;
      right: 1.4rem;
      bottom: 0.45rem;
      left: 2rem;
      border-top: 1px solid var(--ink);
      text-align: center;
    }
    .dim-h::before,
    .dim-h::after {
      content: '';
      position: absolute;
      top: -4px;
      height: 8px;
      border-left: 1px solid var(--ink);
    }
    .dim-h::before {
      left: 0;
    }
    .dim-h::after {
      right: 0;
    }
    .dim-h span {
      position: relative;
      top: -0.65rem;
      padding: 0 0.45rem;
      background: #fff;
      font-size: 0.62rem;
    }
    .wordmark {
      font-size: clamp(3rem, 8vw, 5.5rem);
      font-weight: 700;
      line-height: 0.95;
      letter-spacing: -0.03em;
    }
    .tagline {
      font-size: clamp(1.1rem, 2.4vw, 1.6rem);
      font-weight: 500;
      margin-top: 0.6rem;
      opacity: 0.9;
    }
    .intro {
      max-width: 54ch;
      margin-top: 1.25rem;
      font-size: 1.02rem;
      line-height: 1.65;
      color: var(--void);
      opacity: 0.85;
    }
    .system {
      margin-top: 2.5rem;
      border: 1px solid var(--line);
      background: #fff;
      padding: 1.1rem 1.35rem;
      font-size: 0.85rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.6rem 2rem;
    }
    .system-tag {
      opacity: 0.6;
    }
    .system-eq {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      color: var(--ink);
    }
    .system-params {
      color: var(--accent);
      margin-left: auto;
    }

    /* Annotated rule (section header) */
    .rule {
      position: relative;
      border-top: 1px solid var(--ink);
      margin: 3.25rem 0 1.5rem;
    }
    .rule span {
      position: absolute;
      top: -0.75rem;
      left: 0;
      background: var(--paper);
      padding-right: 0.75rem;
      font-size: 0.75rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .section-intro {
      max-width: 62ch;
      font-size: 0.98rem;
      line-height: 1.6;
      opacity: 0.8;
      margin-bottom: 1.75rem;
    }

    /* Mark grid */
    .mark-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    .mark-cell {
      border: 1px solid var(--line);
      display: flex;
      flex-direction: column;
    }
    .mark-cell img {
      width: 100%;
      height: 150px;
      object-fit: contain;
      padding: 1.5rem;
    }
    .mark-cell.is-hatch img {
      background-image: repeating-linear-gradient(
        45deg,
        var(--hatch) 0,
        var(--hatch) 1px,
        transparent 1px,
        transparent 8px
      );
    }
    .mark-cell.is-dark {
      background: var(--void);
    }
    .mark-cell figcaption {
      border-top: 1px solid var(--line);
      padding: 0.7rem 0.85rem 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      background: #fff;
    }
    .mark-label {
      font-size: 0.72rem;
      color: var(--ink);
    }
    .mark-note {
      font-size: 0.8rem;
      line-height: 1.4;
      opacity: 0.65;
    }
    .mark-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 1rem;
    }
    .mark-actions a {
      border: 1px solid var(--ink);
      padding: 0.55rem 0.75rem;
      color: var(--ink);
      font-size: 0.68rem;
      letter-spacing: 0.04em;
      text-decoration: none;
      transition:
        background 150ms ease,
        color 150ms ease;
    }
    .mark-actions a:hover,
    .mark-actions a:focus-visible {
      background: var(--ink);
      color: #fff;
    }
    .usage-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr 1fr;
      gap: 1px;
      margin-top: 2rem;
      border: 1px solid var(--line);
      background: var(--line);
    }
    .usage-grid > div {
      padding: 1.2rem;
      background: #fff;
    }
    .usage-label {
      display: block;
      margin-bottom: 0.55rem;
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .usage-intro p,
    .usage-column li {
      font-size: 0.85rem;
      line-height: 1.55;
      color: var(--void);
      opacity: 0.78;
    }
    .usage-column ul {
      display: grid;
      gap: 0.45rem;
      padding-left: 1rem;
    }

    /* Colour */
    .swatch-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 1rem;
    }
    .swatch {
      border: 1px solid var(--line);
    }
    .chip {
      height: 90px;
    }
    .swatch-meta {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      padding: 0.7rem 0.8rem 0.85rem;
      border-top: 1px solid var(--line);
      background: #fff;
    }
    .swatch-hex {
      font-size: 0.75rem;
      color: var(--ink);
    }
    .swatch-name {
      font-size: 0.82rem;
      font-weight: 500;
    }
    .swatch-role {
      font-size: 0.75rem;
      opacity: 0.6;
      line-height: 1.35;
    }

    /* Type */
    .type-stack {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    .face {
      border-left: 1px solid var(--ink);
      padding-left: 1.25rem;
    }
    .face-role {
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      opacity: 0.6;
    }
    .face-sample {
      font-size: clamp(2rem, 5vw, 3.25rem);
      line-height: 1.1;
      margin: 0.35rem 0 0.5rem;
    }
    .face-usage {
      font-size: 0.9rem;
      line-height: 1.55;
      opacity: 0.75;
      max-width: 60ch;
    }

    /* Hatched cards */
    .motif-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    .hatched-card {
      position: relative;
      border: 1px solid var(--line);
      padding: 4.2rem 1.5rem 1.6rem;
      background: #fff;
      transition:
        transform 180ms cubic-bezier(0.34, 1.56, 0.64, 1),
        box-shadow 180ms ease;
    }
    .hatched-card::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: 2.8rem;
      border-bottom: 1px solid var(--line);
      background-image: repeating-linear-gradient(
        45deg,
        var(--hatch) 0,
        var(--hatch) 1px,
        transparent 1px,
        transparent 8px
      );
    }
    .hatched-card:hover {
      transform: rotate(2deg) translate(4px, -4px);
      box-shadow: -8px 8px 0 var(--hatch);
    }
    .card-tag {
      position: absolute;
      top: 0.9rem;
      right: 0.9rem;
      font-size: 0.72rem;
      opacity: 0.5;
    }
    .card-title {
      display: block;
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: 0.4rem;
    }
    .card-body {
      font-size: 0.92rem;
      line-height: 1.55;
      color: var(--void);
      opacity: 0.82;
      max-width: 46ch;
    }

    /* Applied component specimens */
    .component-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2rem;
      align-items: start;
    }
    .component-specimen {
      position: relative;
      padding: 0.75rem 0.75rem 0;
    }
    .component-specimen::before {
      content: '';
      position: absolute;
      inset: 0.75rem 0.75rem 2rem;
      z-index: 0;
      border: 2px solid var(--ink);
      background-image: repeating-linear-gradient(
        45deg,
        transparent,
        transparent 2px,
        var(--ink) 2px,
        var(--ink) 4px
      );
      /* Only the exposed left and bottom strips may render. Keeping the hatch
         out of the card footprint makes the shadow robust across stacking
         contexts and browser compositing. */
      clip-path: polygon(
        calc(100% - 8px) 0,
        100% 0,
        100% 100%,
        0 100%,
        0 calc(100% - 8px),
        calc(100% - 8px) calc(100% - 8px)
      );
      opacity: 0;
      transition: all 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .research-card {
      position: relative;
      z-index: 1;
      border: 1px solid var(--line);
      background: #fff;
      transition: border-color 240ms ease;
    }
    .component-specimen:hover::before {
      opacity: 1;
      transform: translate(9px, 9px);
    }
    .component-specimen:hover .research-card {
      border-color: var(--ink);
    }
    .research-head {
      display: flex;
      justify-content: space-between;
      padding: 0.6rem 0.9rem;
      border-bottom: 1px solid var(--line);
      background-image: repeating-linear-gradient(
        45deg,
        var(--hatch) 0,
        var(--hatch) 1px,
        transparent 1px,
        transparent 8px
      );
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .research-body {
      padding: 1.35rem 1.25rem 1.2rem;
    }
    .research-title {
      margin-bottom: 0.55rem;
      font-size: 1.25rem;
      line-height: 1.25;
    }
    .research-body p {
      max-width: 48ch;
      font-size: 0.92rem;
      line-height: 1.6;
      color: var(--void);
      opacity: 0.78;
    }
    .research-status {
      display: block;
      margin-top: 1rem;
      padding-top: 0.7rem;
      border-top: 1px solid var(--line);
      font-size: 0.68rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .specimen-caption,
    .specimen-label {
      position: relative;
