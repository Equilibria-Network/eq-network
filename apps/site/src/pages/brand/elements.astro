---
// src/pages/brand/elements.astro
// PROTOTYPE component-options showcase for the blueprint direction. Shows
// several OPTIONS per UI element (research cards, node graph, modal, tooltip,
// hover states) so the owner can pick per-element. NOT the settled brand.
// Self-contained: inline markup + scoped CSS + small inline script for the
// openable dialog and graph hover. Do not treat as final.
import Layout from '@/layouts/Layout.astro';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
---

<Layout
  title="Elements (prototype) - Equilibria Network"
  description="A prototype gallery of blueprint-styled UI element options for the Equilibria Network site: research cards, node graphs, modals, tooltips and hover states."
>
  <div class="el">
    <!-- prototype banner -->
    <div class="proto-banner ff-mono">
      prototype // component options — several treatments per element for per-element selection. Not
      final.
    </div>

    <div class="sheet">
      <!-- prototype switcher -->
      <nav class="proto-switch ff-mono">
        <span>proto /</span>
        <a href="/brand">A</a>
        <a href="/brand/b">B</a>
        <a href="/brand/c">C</a>
        <a href="/brand/d">D</a>
        <a href="/brand/elements" aria-current="page">elements</a>
      </nav>

      <!-- page header -->
      <header class="page-head">
        <span class="tag ff-mono">UI ELEMENTS · GALLERY</span>
        <h1 class="ff-display page-title">Element options</h1>
        <p class="page-intro">
          Blueprint-styled candidates for the core interface pieces. Each element below shows two or
          three treatments, labelled so a single option can be chosen per element without committing
          the whole set.
        </p>
      </header>

      <!-- ============ 1. RESEARCH CARDS ============ -->
      <section>
        <div class="rule ff-mono"><span>01 / research cards</span></div>
        <p class="section-intro">
          Three treatments for a single research item: title, one-line abstract, a mono phase/status
          tag and a hairline meta row.
        </p>

        <div class="card-grid">
          <!-- option 1: hairline border + mono corner tag -->
          <figure class="opt">
            <article class="rc rc-1">
              <span class="rc-1-tag ff-mono">PHASE 02</span>
              <h3 class="ff-display rc-title">Bounded-influence objectives</h3>
              <p class="rc-abstract">
                Reward shaping that keeps a policy's causal footprint inside a measured envelope
                under distribution shift.
              </p>
              <div class="rc-meta ff-mono">
                <span>ref EQ-014</span>
                <span class="rc-dot"></span>
                <span>status: active</span>
              </div>
            </article>
            <figcaption class="ff-mono opt-cap">card / option 1 — hairline + corner tag</figcaption>
          </figure>

          <!-- option 2: hatched header strip + sharp body -->
          <figure class="opt">
            <article class="rc rc-2">
              <div class="rc-2-head ff-mono">
                <span>PHASE 02</span>
                <span>EQ-014</span>
              </div>
              <div class="rc-2-body">
                <h3 class="ff-display rc-title">Bounded-influence objectives</h3>
                <p class="rc-abstract">
                  Reward shaping that keeps a policy's causal footprint inside a measured envelope
                  under distribution shift.
                </p>
                <div class="rc-meta ff-mono">
                  <span>status: active</span>
                </div>
              </div>
            </article>
            <figcaption class="ff-mono opt-cap">card / option 2 — hatched header strip</figcaption>
          </figure>

          <!-- option 3: left dimension-line accent -->
          <figure class="opt">
            <article class="rc rc-3">
              <div class="rc-3-dim ff-mono"><span>02</span></div>
              <div class="rc-3-body">
                <span class="ff-mono rc-3-tag">PHASE 02 · active</span>
                <h3 class="ff-display rc-title">Bounded-influence objectives</h3>
                <p class="rc-abstract">
                  Reward shaping that keeps a policy's causal footprint inside a measured envelope
                  under distribution shift.
                </p>
                <div class="rc-meta ff-mono">
                  <span>ref EQ-014</span>
                </div>
              </div>
            </article>
            <figcaption class="ff-mono opt-cap">card / option 3 — dimension-line accent</figcaption>
          </figure>
        </div>
      </section>

      <!-- ============ 2. DYNAMIC GRAPH ============ -->
      <section>
        <div class="rule ff-mono"><span>02 / node graph</span></div>
        <p class="section-intro">
          Small tech-tree / dependency graph. Sharp nodes, hairline edges, mono labels. Option 1 is
          a static plate; option 2 highlights a node and its connected edges on hover.
        </p>

        <div class="graph-grid">
          <!-- option 1: static -->
          <figure class="opt">
            <div class="graph-frame">
              <svg viewBox="0 0 420 210" class="bp-graph" role="img" aria-label="Static node graph">
                <!-- edges -->
                <g class="edges" stroke="#003B7E" stroke-width="1" opacity="0.4">
                  <line x1="52" y1="105" x2="168" y2="55"></line>
                  <line x1="52" y1="105" x2="168" y2="155"></line>
                  <line x1="180" y1="55" x2="296" y2="105"></line>
                  <line x1="180" y1="155" x2="296" y2="105"></line>
                  <line x1="308" y1="105" x2="384" y2="105"></line>
                </g>
                <!-- nodes -->
                <g class="nodes">
                  <rect x="40" y="97" width="16" height="16"></rect>
                  <rect x="168" y="47" width="16" height="16"></rect>
                  <rect x="168" y="147" width="16" height="16"></rect>
                  <rect x="296" y="97" width="16" height="16"></rect>
                  <rect x="376" y="97" width="16" height="16"></rect>
                </g>
                <!-- labels -->
                <g class="glabels ff-mono" fill="#003B7E" font-size="9" text-anchor="middle">
                  <text x="48" y="130">input</text>
                  <text x="176" y="40">model</text>
                  <text x="176" y="180">eval</text>
                  <text x="304" y="130">align</text>
                  <text x="384" y="130">deploy</text>
                </g>
              </svg>
            </div>
            <figcaption class="ff-mono opt-cap">graph / option 1 — static plate</figcaption>
          </figure>

          <!-- option 2: hover highlight -->
          <figure class="opt">
            <div class="graph-frame">
              <svg
                viewBox="0 0 420 210"
                class="bp-graph bp-graph-hover"
                id="graphB"
                role="img"
                aria-label="Interactive node graph, hover a node to highlight its links"
              >
                <g class="edges" stroke="#003B7E" stroke-width="1">
                  <line data-edge="in model" x1="52" y1="105" x2="168" y2="55"></line>
                  <line data-edge="in eval" x1="52" y1="105" x2="168" y2="155"></line>
                  <line data-edge="model align" x1="180" y1="55" x2="296" y2="105"></line>
                  <line data-edge="eval align" x1="180" y1="155" x2="296" y2="105"></line>
                  <line data-edge="align deploy" x1="308" y1="105" x2="384" y2="105"></line>
                </g>
                <g class="nodes">
                  <rect data-node="in" x="40" y="97" width="16" height="16"></rect>
                  <rect data-node="model" x="168" y="47" width="16" height="16"></rect>
                  <rect data-node="eval" x="168" y="147" width="16" height="16"></rect>
                  <rect data-node="align" x="296" y="97" width="16" height="16"></rect>
                  <rect data-node="deploy" x="376" y="97" width="16" height="16"></rect>
                </g>
                <g class="glabels ff-mono" fill="#003B7E" font-size="9" text-anchor="middle">
                  <text x="48" y="130">input</text>
                  <text x="176" y="40">model</text>
                  <text x="176" y="180">eval</text>
                  <text x="304" y="130">align</text>
                  <text x="384" y="130">deploy</text>
                </g>
              </svg>
            </div>
            <figcaption class="ff-mono opt-cap">
              graph / option 2 — hover a node to trace its links
            </figcaption>
          </figure>
        </div>
      </section>

      <!-- ============ 3. POPUP / MODAL ============ -->
      <section>
        <div class="rule ff-mono"><span>03 / modal</span></div>
        <p class="section-intro">
          Two modal framings shown inline as static mocks, plus one live openable dialog so the
          interaction can be felt.
        </p>

        <div class="modal-grid">
          <!-- option 1: mono title bar + corner ticks -->
          <figure class="opt">
            <div class="mock-stage">
              <div class="mm mm-1">
                <div class="mm-1-bar ff-mono">
                  <span>EQ-014 · dossier</span>
                  <span class="mm-x">x</span>
                </div>
                <div class="mm-body">
                  <h3 class="ff-display mm-title">Bounded-influence objectives</h3>
                  <p class="mm-text">
                    A measured envelope on causal footprint, held under shift. Read the working note
                    for the derivation and open problems.
                  </p>
                  <div class="mm-actions ff-mono">
                    <span class="mm-btn">open note</span>
                    <span class="mm-btn ghost">dismiss</span>
                  </div>
                </div>
              </div>
            </div>
            <figcaption class="ff-mono opt-cap">
              modal / option 1 — mono title bar + corner ticks
            </figcaption>
          </figure>

          <!-- option 2: hatched title strip -->
          <figure class="opt">
            <div class="mock-stage">
              <div class="mm mm-2">
                <div class="mm-2-bar ff-mono">
                  <span>dossier // EQ-014</span>
                  <span class="mm-x">[ close ]</span>
                </div>
                <div class="mm-body">
                  <h3 class="ff-display mm-title">Bounded-influence objectives</h3>
                  <p class="mm-text">
                    A measured envelope on causal footprint, held under shift. Read the working note
                    for the derivation and open problems.
                  </p>
                  <div class="mm-actions ff-mono">
                    <span class="mm-btn">open note</span>
                    <span class="mm-btn ghost">dismiss</span>
                  </div>
                </div>
              </div>
            </div>
            <figcaption class="ff-mono opt-cap">modal / option 2 — hatched title strip</figcaption>
          </figure>

          <!-- live demo -->
          <figure class="opt">
            <div class="mock-stage demo-stage">
              <button class="demo-open ff-mono" id="openDialog" type="button">
                open live dialog
              </button>
            </div>
            <figcaption class="ff-mono opt-cap">
              modal / live demo — native &lt;dialog&gt;
            </figcaption>
          </figure>
        </div>

        <!-- real, openable dialog -->
        <dialog class="bp-dialog" id="demoDialog" aria-labelledby="demoDialogTitle">
          <div class="bp-dialog-bar ff-mono">
            <span id="demoDialogTitle">EQ-014 · dossier</span>
            <button class="bp-dialog-x" id="closeDialog" type="button" aria-label="Close dialog">
              x
            </button>
          </div>
          <div class="bp-dialog-body">
            <h3 class="ff-display mm-title">Bounded-influence objectives</h3>
            <p class="mm-text">
              This is a live blueprint dialog. Press Escape, click the backdrop, or use the close
              control to dismiss it. Sharp edges, hairline frame, mono title bar.
            </p>
          </div>
        </dialog>
      </section>

      <!-- ============ 4. TOOLTIP ============ -->
      <section>
        <div class="rule ff-mono"><span>04 / tooltip</span></div>
        <p class="section-intro">
          CSS-only hover tooltips over a sample term. Both use mono type and a small pointer tick;
          they differ in placement and fill.
        </p>

        <div class="tip-row">
          <figure class="opt">
            <p class="tip-line">
              Constrained by a
              <span class="tt tt-1" tabindex="0">
                Lyapunov envelope<span class="tt-1-box ff-mono" role="tooltip"
                  >a bound that provably contracts over time</span
                >
              </span>
              during training.
            </p>
            <figcaption class="ff-mono opt-cap">tooltip / option 1 — solid, above</figcaption>
          </figure>

          <figure class="opt">
            <p class="tip-line">
              Measured against the
              <span class="tt tt-2" tabindex="0">
                influence budget<span class="tt-2-box ff-mono" role="tooltip"
                  >max causal effect a policy may exert</span
                >
              </span>
              per rollout.
            </p>
            <figcaption class="ff-mono opt-cap">tooltip / option 2 — hatched, below</figcaption>
          </figure>
        </div>
      </section>

      <!-- ============ 5. HOVER STATES ============ -->
      <section>
        <div class="rule ff-mono"><span>05 / hover states</span></div>
        <p class="section-intro">Three interactive hover treatments. Move the cursor over each.</p>

        <div class="hover-row">
          <figure class="opt">
            <div class="hover-stage">
              <a href="#0" class="hv-link ff-display">read the note</a>
            </div>
            <figcaption class="ff-mono opt-cap">hover / option 1 — animated underline</figcaption>
          </figure>

          <figure class="opt">
            <div class="hover-stage">
              <div class="hv-card">
                <span class="ff-mono hv-card-tag">EQ-014</span>
                <span class="ff-display hv-card-title">lift + hard shadow</span>
              </div>
            </div>
            <figcaption class="ff-mono opt-cap">
              hover / option 2 — lift with offset shadow
            </figcaption>
          </figure>

          <figure class="opt">
            <div class="hover-stage">
              <button class="hv-btn ff-mono" type="button">invert on hover</button>
            </div>
            <figcaption class="ff-mono opt-cap">hover / option 3 — button inverts</figcaption>
          </figure>
        </div>
      </section>
    </div>
  </div>

  <script>
    // Live dialog wiring (option 3 of the modal section).
    const dialog = document.getElementById('demoDialog') as HTMLDialogElement | null;
    const openBtn = document.getElementById('openDialog');
    const closeBtn = document.getElementById('closeDialog');
    if (dialog && openBtn) {
      openBtn.addEventListener('click', () => dialog.showModal());
    }
    if (dialog && closeBtn) {
      closeBtn.addEventListener('click', () => dialog.close());
    }
    // Click on the backdrop closes the dialog.
    if (dialog) {
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
    }

    // Graph option 2: highlight a node and its connected edges on hover.
    const graph = document.getElementById('graphB');
    if (graph) {
      const nodes = Array.from(graph.querySelectorAll<SVGRectElement>('[data-node]'));
      const edges = Array.from(graph.querySelectorAll<SVGLineElement>('[data-edge]'));
      const clear = () => {
        graph.classList.remove('is-active');
        nodes.forEach((n) => n.classList.remove('lit'));
        edges.forEach((el) => el.classList.remove('lit'));
      };
      nodes.forEach((node) => {
        const id = node.getAttribute('data-node');
        const activate = () => {
          graph.classList.add('is-active');
          nodes.forEach((n) => n.classList.remove('lit'));
          edges.forEach((el) => el.classList.remove('lit'));
          node.classList.add('lit');
          edges.forEach((el) => {
            const pair = (el.getAttribute('data-edge') || '').split(' ');
            if (id && pair.includes(id)) el.classList.add('lit');
          });
        };
        node.addEventListener('mouseenter', activate);
        node.addEventListener('focus', activate);
        node.addEventListener('mouseleave', clear);
        node.addEventListener('blur', clear);
      });
    }
  </script>

  <style>
    /* ============ blueprint element gallery (prototype) ============ */
    .el {
      --ink: #003b7e;
      --accent: #4ab3f4;
      --dark: #0b1f3a;
      --line: rgba(0, 59, 126, 0.15);
      --hatch: rgba(0, 59, 126, 0.06);
      background: #ffffff;
      color: var(--ink);
    }
    .ff-display {
      font-family: 'Space Grotesk', system-ui, sans-serif;
    }
    .ff-mono {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
    }

    .proto-banner {
      background: var(--dark);
      color: #fff;
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      text-align: center;
      padding: 0.55rem 1rem;
    }

    .sheet {
      position: relative;
      max-width: 1120px;
      margin: 0 auto;
      padding: 3.5rem 3.5rem 5rem;
      background: #ffffff;
    }

    /* prototype switcher */
    .proto-switch {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      margin-bottom: 2.5rem;
    }
    .proto-switch span {
      opacity: 0.5;
    }
    .proto-switch a {
      color: var(--ink);
      text-decoration: none;
      border: 1px solid var(--line);
      padding: 0.2rem 0.6rem;
    }
    .proto-switch a:hover {
      border-color: var(--ink);
    }
    .proto-switch a[aria-current='page'] {
      background: var(--ink);
      color: #fff;
      border-color: var(--ink);
    }

    /* page header */
    .page-head {
      margin-bottom: 1rem;
    }
    .tag {
      display: inline-block;
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      opacity: 0.7;
      border: 1px solid var(--line);
      padding: 0.25rem 0.6rem;
    }
    .page-title {
      font-size: clamp(2.5rem, 6vw, 4rem);
      font-weight: 700;
      line-height: 0.98;
      letter-spacing: -0.03em;
      margin-top: 1.1rem;
    }
    .page-intro {
      max-width: 60ch;
      margin-top: 1rem;
      font-size: 1.02rem;
      line-height: 1.65;
      color: var(--dark);
      opacity: 0.85;
    }

    /* annotated rule (section header) */
    .rule {
      position: relative;
      border-top: 1px solid var(--ink);
      margin: 3.5rem 0 1.25rem;
    }
    .rule span {
      position: absolute;
      top: -0.75rem;
      left: 0;
      background: #ffffff;
      padding-right: 0.75rem;
      font-size: 0.75rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .section-intro {
      max-width: 64ch;
      font-size: 0.96rem;
      line-height: 1.6;
      opacity: 0.8;
      margin-bottom: 1.75rem;
    }

    /* shared option wrapper + caption */
    .opt {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .opt-cap {
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      opacity: 0.6;
    }

    /* ---------- 1. research cards ---------- */
    .card-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    .rc-title {
      font-size: 1.12rem;
      font-weight: 700;
      line-height: 1.15;
      margin-bottom: 0.5rem;
    }
    .rc-abstract {
      font-size: 0.9rem;
      line-height: 1.5;
      color: var(--dark);
      opacity: 0.82;
    }
    .rc-meta {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.7rem;
      letter-spacing: 0.03em;
      opacity: 0.65;
      margin-top: 0.9rem;
      border-top: 1px solid var(--line);
      padding-top: 0.6rem;
    }
    .rc-dot {
      width: 4px;
      height: 4px;
      background: var(--accent);
    }

    /* option 1: hairline border + mono corner tag */
    .rc-1 {
      position: relative;
      border: 1px solid var(--line);
      background: #fff;
      padding: 1.4rem 1.35rem 1.2rem;
    }
    .rc-1-tag {
      position: absolute;
      top: 0.8rem;
      right: 0.9rem;
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      opacity: 0.5;
    }

    /* option 2: hatched header strip + sharp body */
    .rc-2 {
      border: 1px solid var(--line);
      background: #fff;
    }
    .rc-2-head {
      display: flex;
      justify-content: space-between;
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      padding: 0.55rem 0.9rem;
      color: var(--ink);
      border-bottom: 1px solid var(--line);
      background-image: repeating-linear-gradient(
        45deg,
        var(--hatch) 0,
        var(--hatch) 1px,
        transparent 1px,
        transparent 8px
      );
    }
    .rc-2-body {
      padding: 1.2rem 1.1rem 1.1rem;
    }

    /* option 3: left dimension-line accent */
    .rc-3 {
      display: flex;
      border: 1px solid var(--line);
      background: #fff;
    }
    .rc-3-dim {
      position: relative;
      flex: 0 0 34px;
      border-right: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    /* dimension ticks along the accent rail */
    .rc-3-dim::before {
      content: '';
      position: absolute;
      inset: 0.5rem auto 0.5rem 50%;
      width: 1px;
      background: var(--ink);
      opacity: 0.5;
    }
    .rc-3-dim span {
      position: relative;
      z-index: 1;
      background: #fff;
      padding: 0.2rem 0;
      font-size: 0.7rem;
      color: var(--ink);
      writing-mode: vertical-rl;
      letter-spacing: 0.1em;
    }
    .rc-3-body {
      padding: 1.3rem 1.3rem 1.1rem;
    }
    .rc-3-tag {
      display: block;
      font-size: 0.68rem;
      letter-spacing: 0.06em;
      opacity: 0.5;
      margin-bottom: 0.5rem;
    }

    /* ---------- 2. node graph ---------- */
    .graph-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
    .graph-frame {
      border: 1px solid var(--line);
      background: #fff;
      background-image: repeating-linear-gradient(
        45deg,
        var(--hatch) 0,
        var(--hatch) 1px,
        transparent 1px,
        transparent 8px
      );
      padding: 1.2rem;
    }
    .bp-graph {
      display: block;
      width: 100%;
      height: auto;
    }
    .bp-graph .nodes rect {
      fill: #fff;
      stroke: var(--ink);
      stroke-width: 1.5;
    }
    .bp-graph .glabels text {
      letter-spacing: 0.04em;
    }
    /* option 2 interactive states (classes toggled by inline script) */
    .bp-graph-hover .nodes rect,
    .bp-graph-hover .edges line,
    .bp-graph-hover .glabels text {
      transition:
        opacity 0.15s ease,
        fill 0.15s ease,
        stroke-width 0.15s ease;
    }
    .bp-graph-hover .edges line {
      opacity: 0.35;
    }
    .bp-graph-hover.is-active .edges line {
      opacity: 0.08;
    }
    .bp-graph-hover.is-active .nodes rect {
      opacity: 0.4;
    }
    .bp-graph-hover .nodes rect {
      cursor: pointer;
    }
    .bp-graph-hover .edges line.lit {
      opacity: 0.9;
      stroke-width: 2;
    }
    .bp-graph-hover .nodes rect.lit {
      opacity: 1;
      fill: var(--accent);
      stroke: var(--ink);
    }

    /* ---------- 3. modal ---------- */
    .modal-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    .mock-stage {
      border: 1px solid var(--line);
      background-image: repeating-linear-gradient(
        45deg,
        var(--hatch) 0,
        var(--hatch) 1px,
        transparent 1px,
        transparent 8px
      );
      padding: 1.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 220px;
    }
    .mm {
      width: 100%;
