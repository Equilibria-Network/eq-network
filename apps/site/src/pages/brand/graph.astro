---
// src/pages/brand/graph.astro
// PROTOTYPE brand exploration — a "graph study" for the blueprint / measured
// direction. Shows how the site's thesis graphs could look in the new identity,
// and proves they can be driven by code (d3) and transformed / animated. The
// centrepiece is the <GraphDemo> island; below it are three small STATIC SVG
// "style study" panels so the owner sees the range (force cluster, lattice,
// directed DAG). Self-contained: only this page + the island are new; no shared
// files touched.
import Layout from '@/layouts/Layout.astro';
import GraphDemo from '@components/brand/GraphDemo';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
---

<Layout
  title="Graph study (prototype) - Equilibria Network"
  description="A prototype study of the Equilibria Network thesis graphs in the blueprint identity: programmatic d3 layouts, blueprint styling, and a graph that transforms to communicate a point."
>
  <div class="bp">
    <nav class="proto-switch ff-mono">
      <span>proto /</span>
      <a href="/brand">A</a>
      <a href="/brand/b">B</a>
      <a href="/brand/c">C</a>
      <a href="/brand/d">D</a>
      <a href="/brand/elements">elements</a>
      <a href="/brand/graph" aria-current="page">graph</a>
    </nav>

    <div class="sheet">
      <header class="head">
        <span class="tag ff-mono">graph study</span>
        <h1 class="ff-display title">Graphs, drawn as blueprints</h1>
        <p class="intro">
          The thesis visuals are graphs. This page restyles that kind of picture in the blueprint
          direction and shows it is <em>programmatic</em>: the layout below is computed live with <span
            class="ff-mono">d3-force</span
          >, styled entirely in our palette, and it can <em>transform</em> to make a point. Drag a node
          to feel it settle, <span class="ff-mono">reheat</span> the layout, then <span
            class="ff-mono">propagate</span
          > to watch a cooperative equilibrium spread outward from two seeds across the network. Same
          technique we would use for the thesis figures — this is a prototype, not the final art.
        </p>
      </header>

      <section>
        <div class="rule ff-mono"><span>live / d3-force</span></div>
        <GraphDemo client:only="react" />
        <p class="caption ff-mono">
          // interactive · draggable nodes · force sim · state transform. filled square = cooperate,
          hollow = defect, dashed = weak tie.
        </p>
      </section>

      <section>
        <div class="rule ff-mono"><span>style / static studies</span></div>
        <p class="section-intro">
          Static reference sketches (no JavaScript) showing three graph-theory layouts in the same
          blueprint language, to gauge range before committing.
        </p>

        <div class="study-grid">
          <!-- (a) force / cluster graph -->
          <figure class="study">
            <svg
              class="study-svg"
              viewBox="0 0 200 150"
              role="img"
              aria-label="Force cluster graph sketch"
            >
              <rect x="0" y="0" width="200" height="150" fill="#ffffff"></rect>
              <rect x="0" y="0" width="200" height="150" fill="url(#gp)"></rect>
              <!-- edges -->
              <g stroke="rgba(0,59,126,0.35)" stroke-width="1" fill="none">
                <line x1="60" y1="45" x2="100" y2="70"></line>
                <line x1="140" y1="40" x2="100" y2="70"></line>
                <line x1="45" y1="95" x2="100" y2="70"></line>
                <line x1="150" y1="100" x2="100" y2="70"></line>
                <line x1="90" y1="115" x2="100" y2="70"></line>
                <line x1="60" y1="45" x2="45" y2="95"></line>
                <line x1="140" y1="40" x2="150" y2="100"></line>
                <line x1="45" y1="95" x2="90" y2="115" stroke-dasharray="4 4"></line>
                <line x1="150" y1="100" x2="90" y2="115" stroke-dasharray="4 4"></line>
              </g>
              <!-- nodes -->
              <g fill="#ffffff" stroke="#003B7E" stroke-width="1.5">
                <rect x="55" y="40" width="10" height="10"></rect>
                <rect x="135" y="35" width="10" height="10"></rect>
                <rect x="40" y="90" width="10" height="10"></rect>
                <rect x="145" y="95" width="10" height="10"></rect>
                <rect x="85" y="110" width="10" height="10"></rect>
              </g>
              <rect
                x="95"
                y="65"
                width="10"
                height="10"
                fill="#003B7E"
                stroke="#003B7E"
                stroke-width="1.5"></rect>
            </svg>
            <figcaption class="ff-mono">fig. a / force cluster</figcaption>
          </figure>

          <!-- (b) lattice / grid graph -->
          <figure class="study">
            <svg
              class="study-svg"
              viewBox="0 0 200 150"
              role="img"
              aria-label="Lattice grid graph sketch"
            >
              <rect x="0" y="0" width="200" height="150" fill="#ffffff"></rect>
              <rect x="0" y="0" width="200" height="150" fill="url(#gp)"></rect>
              <g stroke="rgba(0,59,126,0.35)" stroke-width="1" fill="none">
                <!-- horizontals -->
                <line x1="40" y1="35" x2="160" y2="35"></line>
                <line x1="40" y1="75" x2="160" y2="75"></line>
                <line x1="40" y1="115" x2="160" y2="115"></line>
                <!-- verticals -->
                <line x1="40" y1="35" x2="40" y2="115"></line>
                <line x1="100" y1="35" x2="100" y2="115"></line>
                <line x1="160" y1="35" x2="160" y2="115"></line>
              </g>
              <g fill="#ffffff" stroke="#003B7E" stroke-width="1.5">
                <rect x="35" y="30" width="10" height="10"></rect>
                <rect x="95" y="30" width="10" height="10"></rect>
                <rect x="155" y="30" width="10" height="10"></rect>
                <rect x="35" y="70" width="10" height="10"></rect>
                <rect x="155" y="70" width="10" height="10"></rect>
                <rect x="35" y="110" width="10" height="10"></rect>
                <rect x="95" y="110" width="10" height="10"></rect>
                <rect x="155" y="110" width="10" height="10"></rect>
              </g>
              <!-- centre in the "cooperate" state -->
              <rect
                x="95"
                y="70"
                width="10"
                height="10"
                fill="#003B7E"
                stroke="#003B7E"
                stroke-width="1.5"></rect>
            </svg>
            <figcaption class="ff-mono">fig. b / lattice</figcaption>
          </figure>

          <!-- (c) directed DAG with arrowheads -->
          <figure class="study">
            <svg
              class="study-svg"
              viewBox="0 0 200 150"
              role="img"
              aria-label="Directed acyclic graph sketch with arrowheads"
            >
              <defs>
                <marker
                  id="ah"
                  viewBox="0 0 10 10"
                  refX="9"
                  refY="5"
                  markerWidth="6"
                  markerHeight="6"
                  orient="auto-start-reverse"
                >
                  <path d="M0 0 L10 5 L0 10 z" fill="#003B7E"></path>
                </marker>
              </defs>
              <rect x="0" y="0" width="200" height="150" fill="#ffffff"></rect>
              <rect x="0" y="0" width="200" height="150" fill="url(#gp)"></rect>
              <g stroke="#003B7E" stroke-width="1" fill="none" marker-end="url(#ah)">
                <line x1="45" y1="30" x2="88" y2="62"></line>
                <line x1="45" y1="120" x2="88" y2="82"></line>
                <line x1="112" y1="72" x2="150" y2="45"></line>
                <line x1="112" y1="72" x2="150" y2="105"></line>
              </g>
              <g fill="#ffffff" stroke="#003B7E" stroke-width="1.5">
                <rect x="35" y="25" width="10" height="10"></rect>
                <rect x="35" y="115" width="10" height="10"></rect>
                <rect x="150" y="40" width="10" height="10"></rect>
                <rect x="150" y="100" width="10" height="10"></rect>
              </g>
              <rect
                x="95"
                y="67"
                width="10"
                height="10"
                fill="#003B7E"
                stroke="#003B7E"
                stroke-width="1.5"></rect>
            </svg>
            <figcaption class="ff-mono">fig. c / directed DAG</figcaption>
          </figure>
        </div>
      </section>

      <!-- shared graph-paper pattern for the static studies -->
      <svg width="0" height="0" aria-hidden="true" style="position:absolute">
        <defs>
          <pattern id="gp" width="20" height="20" patternUnits="userSpaceOnUse">
            <path d="M20 0 H0 V20" fill="none" stroke="#e7edf5" stroke-width="1"></path>
          </pattern>
        </defs>
      </svg>
    </div>
  </div>

  <style>
    /* ============ graph study — blueprint prototype ============ */
    .bp {
      --ink: #003b7e;
      --accent: #4ab3f4;
      --void: #0b1f3a;
      --paper: #ffffff;
      --line: rgba(0, 59, 126, 0.16);
      background: var(--paper);
      color: var(--ink);
    }
    .ff-display {
      font-family: 'Space Grotesk', system-ui, sans-serif;
    }
    .ff-mono {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
    }

    .proto-switch {
      display: flex;
      flex-wrap: wrap;
      gap: 1.25rem;
      align-items: center;
      justify-content: center;
      padding: 0.6rem 1rem;
      border-bottom: 1px solid var(--line);
      font-size: 0.72rem;
      background: #fff;
    }
    .proto-switch span {
      opacity: 0.5;
    }
    .proto-switch a {
      color: var(--ink);
      text-decoration: none;
      opacity: 0.7;
    }
    .proto-switch a:hover {
      opacity: 1;
    }
    .proto-switch a[aria-current='page'] {
      opacity: 1;
      border-bottom: 2px solid var(--accent);
      padding-bottom: 2px;
    }

    .sheet {
      position: relative;
      max-width: 1120px;
      margin: 0 auto;
      padding: 4rem 3.5rem 5rem;
      background: var(--paper);
    }
    .sheet::before {
      content: '';
      position: absolute;
      inset: 1.5rem;
      border: 1px solid var(--line);
      pointer-events: none;
    }

    .head {
      margin-bottom: 2.5rem;
    }
    .tag {
      display: inline-block;
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink);
      opacity: 0.7;
      border: 1px solid var(--line);
      padding: 0.25rem 0.6rem;
    }
    .title {
      font-size: clamp(2rem, 5vw, 3.25rem);
      font-weight: 700;
      line-height: 1;
      letter-spacing: -0.02em;
      margin-top: 1rem;
    }
    .intro {
      max-width: 66ch;
      margin-top: 1.1rem;
      font-size: 1.02rem;
      line-height: 1.65;
      color: var(--void);
      opacity: 0.85;
    }
    .intro em {
      font-style: normal;
      border-bottom: 1px solid var(--accent);
    }

    .rule {
      position: relative;
      border-top: 1px solid var(--ink);
      margin: 3rem 0 1.5rem;
    }
    .rule span {
      position: absolute;
      top: -0.75rem;
      left: 0;
      background: var(--paper);
      padding-right: 0.75rem;
      font-size: 0.75rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--ink);
    }
    .section-intro {
      max-width: 62ch;
      font-size: 0.98rem;
      line-height: 1.6;
      opacity: 0.8;
      margin-bottom: 1.75rem;
    }
    .caption {
      margin-top: 0.7rem;
      font-size: 0.72rem;
      opacity: 0.6;
    }

    .study-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
    .study {
      border: 1px solid var(--line);
      background: #fff;
    }
    .study-svg {
      display: block;
      width: 100%;
      height: auto;
      border-bottom: 1px solid var(--line);
    }
    .study figcaption {
      padding: 0.6rem 0.75rem 0.7rem;
      font-size: 0.72rem;
      opacity: 0.65;
    }

    @media (max-width: 820px) {
      .sheet {
        padding: 3rem 1.5rem 3.5rem;
      }
      .study-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
