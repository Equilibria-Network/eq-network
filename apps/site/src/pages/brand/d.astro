---
// src/pages/brand/d.astro
// PROTOTYPE brand exploration - direction "D / minimal editorial". Not the settled
// brand. The calm, restrained branch: generous white space, one large confident
// Lorenz mark, a tight Space Grotesk wordmark, sparse mono annotations, hairline
// rules for structure, and exactly one small hatched accent (the single card).
// Self-contained page. Layout via Tailwind utilities; the editorial system is the
// scoped-CSS layer below.
import Layout from '@/layouts/Layout.astro';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

const swatches = [
  { hex: '#003B7E', name: 'Navy', role: 'primary ink' },
  { hex: '#4AB3F4', name: 'Accent', role: 'signal' },
  { hex: '#0B1F3A', name: 'Dark', role: 'depth' },
  { hex: '#FFFFFF', name: 'White', role: 'ground' },
];
---

<Layout
  title="Brand D (prototype) - Equilibria Network"
  description="A prototype exploration of the Equilibria Network identity: a calm, minimal editorial direction built on generous white space, the Lorenz mark, and a single hatched accent."
>
  <div class="ed">
    <div class="wrap">
      <!-- prototype switcher -->
      <nav class="proto-switch ff-mono">
        <span>proto /</span>
        <a href="/brand">A</a>
        <a href="/brand/b">B</a>
        <a href="/brand/c">C</a>
        <a href="/brand/d" aria-current="page">D</a>
        <a href="/brand/elements">elements</a>
      </nav>

      <!-- masthead index line -->
      <div class="index ff-mono">
        <span>Equilibria Network</span>
        <span>Identity study</span>
        <span>D / minimal editorial</span>
      </div>
      <div class="hair"></div>

      <!-- Hero: one confident mark + wordmark + tagline -->
      <header class="hero">
        <figure class="hero-mark">
          <img
            src="/img/brand/marks/v-outline.svg"
            alt="Equilibria Lorenz mark"
            width="220"
            height="220"
          />
          <figcaption class="ff-mono">fig. 01 / Lorenz attractor</figcaption>
        </figure>

        <div class="hero-lead">
          <span class="eyebrow ff-mono">01 &mdash; the mark</span>
          <h1 class="ff-display wordmark">Equilibria</h1>
          <p class="ff-display tagline">Designing new forms of collective intelligence.</p>
          <p class="ff-mono coords">&sigma; 10.0 &nbsp; &rho; 28.0 &nbsp; &beta; 2.667</p>
        </div>
      </header>

      <div class="hair"></div>

      <!-- Colour: minimal row -->
      <section class="block">
        <div class="rule ff-mono"><span>02 / colour</span></div>
        <div class="swatch-row">
          {
            swatches.map((s) => (
              <div class="swatch">
                <div
                  class="chip"
                  style={`background:${s.hex};${
                    s.hex === '#FFFFFF' ? 'box-shadow: inset 0 0 0 1px var(--line);' : ''
                  }`}
                />
                <span class="ff-mono chip-hex">{s.hex}</span>
                <span class="chip-name">{s.name}</span>
                <span class="ff-mono chip-role">{s.role}</span>
              </div>
            ))
          }
        </div>
      </section>

      <div class="hair"></div>

      <!-- Type: clean specimen -->
      <section class="block">
        <div class="rule ff-mono"><span>03 / type</span></div>
        <div class="type-stack">
          <div class="face">
            <span class="ff-mono face-role">[ display ] Space Grotesk</span>
            <p class="ff-display face-sample">Order held in tension.</p>
            <p class="face-usage">
              Headlines, wordmark, and short editorial statements. Set tight, with a negative
              tracking on the largest sizes.
            </p>
          </div>
          <div class="face">
            <span class="ff-mono face-role">[ mono ] IBM Plex Mono</span>
            <p class="ff-mono face-sample face-sample-mono">
              sigma / rho / beta &mdash; 10.0 / 28.0 / 2.667
            </p>
            <p class="face-usage">
              Labels, coordinates, captions, and data. The measured voice; used sparingly to
              annotate the calm.
            </p>
          </div>
        </div>
      </section>

      <div class="hair"></div>

      <!-- The single hatched accent: one card -->
      <section class="block">
        <div class="rule ff-mono"><span>04 / principle</span></div>
        <div class="hatched-card">
          <span class="ff-mono card-tag">note 01</span>
          <strong class="ff-display card-title">Equilibrium, not stillness.</strong>
          <p class="card-body">
            The Lorenz attractor never repeats yet never escapes its bounds. It is our one
            structural metaphor: dynamic systems that stay coherent under pressure. Hatch appears
            exactly once, here, to mark it.
          </p>
        </div>
      </section>

      <div class="hair"></div>

      <!-- Colophon -->
      <footer class="colophon ff-mono">
        <span>Prototype D &mdash; not final</span>
        <span>Equilibria Network</span>
      </footer>
    </div>
  </div>

  <style>
    /* ============ D / minimal editorial prototype ============ */
    .ed {
      --ink: #003b7e;
      --accent: #4ab3f4;
      --dark: #0b1f3a;
      --line: rgba(0, 59, 126, 0.15);
      --hatch: rgba(0, 59, 126, 0.07);
      background: #ffffff;
      color: var(--ink);
    }
    .ff-display {
      font-family: 'Space Grotesk', system-ui, sans-serif;
    }
    .ff-mono {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
    }

    .wrap {
      max-width: 1040px;
      margin: 0 auto;
      padding: 3.5rem 2.5rem 5rem;
    }

    /* hairline dividers give all the structure */
    .hair {
      height: 1px;
      background: var(--line);
      margin: 3rem 0;
    }

    /* prototype switcher */
    .proto-switch {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.9rem;
      font-size: 0.75rem;
      letter-spacing: 0.04em;
      margin-bottom: 2.5rem;
    }
    .proto-switch span {
      opacity: 0.5;
    }
    .proto-switch a {
      color: var(--ink);
      text-decoration: none;
      opacity: 0.65;
      padding-bottom: 2px;
      border-bottom: 1px solid transparent;
    }
    .proto-switch a:hover {
      opacity: 1;
    }
    .proto-switch a[aria-current='page'] {
      opacity: 1;
      border-bottom-color: var(--accent);
    }

    /* index / masthead line */
    .index {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.6rem 1.5rem;
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      opacity: 0.6;
    }

    /* Hero */
    .hero {
      display: grid;
      grid-template-columns: 300px 1fr;
      gap: 3.5rem;
      align-items: center;
      padding: 2rem 0 1rem;
    }
    .hero-mark {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .hero-mark img {
      width: 100%;
      max-width: 300px;
      height: auto;
      color: var(--ink);
    }
    .hero-mark figcaption {
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      opacity: 0.55;
    }
    .eyebrow {
      display: block;
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      opacity: 0.55;
      margin-bottom: 1.1rem;
    }
    .wordmark {
      font-size: clamp(3.25rem, 9vw, 6rem);
      font-weight: 700;
      line-height: 0.9;
      letter-spacing: -0.04em;
    }
    .tagline {
      font-size: clamp(1.15rem, 2.6vw, 1.7rem);
      font-weight: 400;
      line-height: 1.3;
      margin-top: 1.25rem;
      max-width: 22ch;
      opacity: 0.9;
    }
    .coords {
      font-size: 0.8rem;
      letter-spacing: 0.02em;
      margin-top: 1.75rem;
      color: var(--accent);
    }

    /* Section rule */
    .rule {
      position: relative;
      border-top: 1px solid var(--ink);
      margin-bottom: 2rem;
    }
    .rule span {
      position: absolute;
      top: -0.7rem;
      left: 0;
      background: #ffffff;
      padding-right: 0.75rem;
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    /* Colour row */
    .swatch-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
    .swatch {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .chip {
      height: 96px;
      margin-bottom: 0.4rem;
    }
    .chip-hex {
      font-size: 0.78rem;
    }
    .chip-name {
      font-size: 0.9rem;
      font-weight: 500;
    }
    .chip-role {
      font-size: 0.72rem;
      opacity: 0.55;
    }

    /* Type specimen */
    .type-stack {
      display: flex;
      flex-direction: column;
      gap: 2.75rem;
    }
    .face-role {
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      opacity: 0.55;
    }
    .face-sample {
      font-size: clamp(2rem, 5.5vw, 3.5rem);
      line-height: 1.05;
      letter-spacing: -0.02em;
      margin: 0.5rem 0 0.75rem;
    }
    .face-sample-mono {
      font-size: clamp(1.1rem, 3vw, 1.75rem);
      letter-spacing: 0;
      opacity: 0.85;
    }
    .face-usage {
      font-size: 0.95rem;
      line-height: 1.6;
      opacity: 0.75;
      max-width: 58ch;
    }

    /* The one hatched card */
    .hatched-card {
      position: relative;
      border: 1px solid var(--line);
      padding: 2.25rem 2.25rem 2.4rem;
      max-width: 620px;
      background-color: #ffffff;
      background-image: repeating-linear-gradient(
        45deg,
        var(--hatch) 0,
        var(--hatch) 1px,
        transparent 1px,
        transparent 9px
      );
    }
    .card-tag {
      position: absolute;
      top: 1rem;
      right: 1.1rem;
      font-size: 0.72rem;
      opacity: 0.5;
    }
    .card-title {
      display: block;
      font-size: clamp(1.4rem, 3vw, 1.9rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 0.75rem;
    }
    .card-body {
      font-size: 0.98rem;
      line-height: 1.65;
      color: var(--dark);
      opacity: 0.82;
      max-width: 48ch;
    }

    /* Colophon */
    .colophon {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.6rem 1.5rem;
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      opacity: 0.55;
    }

    @media (max-width: 820px) {
      .wrap {
        padding: 2.5rem 1.5rem 3.5rem;
      }
      .hero {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      .hero-mark img {
        max-width: 220px;
      }
      .swatch-row {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>
</Layout>
