---
// src/pages/brand/marks.astro
// PROTOTYPE mark gallery: the symmetric butterfly mark options at size, on light
// and dark, for the owner to pick. Self-contained; not the settled mark.
import Layout from '@/layouts/Layout.astro';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

const marks = [
  {
    label: '01 / concentric',
    src: '/img/brand/marks/sym-concentric.svg',
    note: 'Thick outer + nested thin contours. Default.',
  },
  {
    label: '02 / duo',
    src: '/img/brand/marks/sym-concentric.svg',
    src2: '/img/brand/marks/sym-duo.svg',
    note: 'Thick outer + one inner. More minimal.',
  },
  {
    label: '03 / outline',
    src: '/img/brand/marks/sym-outline.svg',
    note: 'Bare closed silhouette.',
  },
  {
    label: '04 / noise',
    src: '/img/brand/marks/sym-noise.svg',
    note: 'Jittered / organic inner contours.',
  },
  {
    label: '05 / accent',
    src: '/img/brand/marks/sym-concentric-accent.svg',
    note: 'Accent colourway.',
  },
];
---

<Layout
  title="Marks (prototype) - Equilibria Network"
  description="Symmetric butterfly mark options for the Equilibria identity."
>
  <div class="mk">
    <nav class="proto-switch ff-mono">
      <span>proto /</span>
      <a href="/brand">A</a>
      <a href="/brand/b">B</a>
      <a href="/brand/c">C</a>
      <a href="/brand/d">D</a>
      <a href="/brand/elements">elements</a>
      <a href="/brand/graph">graph</a>
      <a href="/brand/marks" aria-current="page">marks</a>
    </nav>

    <div class="wrap">
      <span class="tag ff-mono">Identity / mark options</span>
      <h1 class="ff-display title">The mark</h1>
      <p class="lead">
        A symmetric butterfly derived from the Lorenz attractor: two identical wings, a thick outer
        contour with thin inner lines. Pick a treatment (and say heavier/lighter, more/fewer rings,
        or a different inner topology).
      </p>

      <div class="grid">
        {
          marks.map((m) => (
            <figure class="cell">
              <div class="stage light">
                <img src={m.src2 ?? m.src} alt={m.label} width="150" height="150" />
              </div>
              <div class="stage dark">
                <img
                  src="/img/brand/marks/sym-concentric-white.svg"
                  alt={`${m.label} reversed`}
                  width="150"
                  height="150"
                />
              </div>
              <figcaption>
                <span class="ff-mono lbl">{m.label}</span>
                <span class="note">{m.note}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <div class="scale-row">
        <span class="ff-mono lbl">holds at size —</span>
        <img src="/img/brand/marks/sym-concentric.svg" width="88" height="88" alt="88" />
        <img src="/img/brand/marks/sym-duo.svg" width="52" height="52" alt="52" />
        <img src="/img/brand/marks/sym-outline.svg" width="32" height="32" alt="32" />
        <img src="/img/brand/marks/sym-outline.svg" width="20" height="20" alt="20" />
      </div>
    </div>
  </div>

  <style>
    .mk {
      --ink: #003b7e;
      --line: rgba(0, 59, 126, 0.16);
      --void: #0b1f3a;
      background: #fff;
      color: var(--ink);
    }
    .ff-display {
      font-family: 'Space Grotesk', system-ui, sans-serif;
    }
    .ff-mono {
      font-family: 'IBM Plex Mono', ui-monospace, monospace;
    }
    .proto-switch {
      display: flex;
      flex-wrap: wrap;
      gap: 1.1rem;
      justify-content: center;
      padding: 0.6rem 1rem;
      border-bottom: 1px solid var(--line);
      font-size: 0.72rem;
    }
    .proto-switch span {
      opacity: 0.5;
    }
    .proto-switch a {
      color: var(--ink);
      text-decoration: none;
      opacity: 0.7;
    }
    .proto-switch a[aria-current='page'] {
      opacity: 1;
      border-bottom: 2px solid #4ab3f4;
      padding-bottom: 2px;
    }
    .wrap {
      max-width: 1000px;
      margin: 0 auto;
      padding: 3.5rem 2rem 5rem;
    }
    .tag {
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      opacity: 0.65;
      border: 1px solid var(--line);
      padding: 0.25rem 0.6rem;
    }
    .title {
      font-size: 3rem;
      font-weight: 700;
      margin: 1rem 0 0.5rem;
    }
    .lead {
      max-width: 60ch;
      line-height: 1.6;
      opacity: 0.8;
      margin-bottom: 2.5rem;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
    .cell {
      border: 1px solid var(--line);
      display: flex;
      flex-direction: column;
    }
    .stage {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      min-height: 150px;
    }
    .stage.light {
      background:
        linear-gradient(#fff, #fff) padding-box,
        repeating-linear-gradient(
          45deg,
          rgba(0, 59, 126, 0.05) 0,
          rgba(0, 59, 126, 0.05) 1px,
          transparent 1px,
          transparent 8px
        );
    }
    .stage.dark {
      background: var(--void);
      border-top: 1px solid var(--line);
    }
    .stage img {
      width: 130px;
      height: auto;
    }
    figcaption {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: 0.75rem 0.9rem 0.9rem;
      border-top: 1px solid var(--line);
    }
    .lbl {
      font-size: 0.75rem;
      color: var(--ink);
    }
    .note {
      font-size: 0.82rem;
      opacity: 0.65;
      line-height: 1.4;
    }
    .scale-row {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--line);
    }
    @media (max-width: 768px) {
      .grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>
</Layout>
